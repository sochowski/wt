#!/usr/bin/env bash
# =============================================================================
#  wt - Worktree Manager for Multi-Agent CLI Workflow
#  Supports: Claude, Codex, Gemini, opencode
#  Cross-platform: Arch Linux / macOS
# =============================================================================

set -euo pipefail

# -----------------------------------------------------------------------------
#  Configuration
# -----------------------------------------------------------------------------
WT_BASE_DIR="${WT_BASE_DIR:-$HOME/worktrees}"
WT_STATUS_DIR="${WT_STATUS_DIR:-$HOME/.local/state/wt}"
WT_CONFIG_DIR="${WT_CONFIG_DIR:-$HOME/.config/wt}"
WT_LOG_FILE="${WT_LOG_FILE:-$WT_STATUS_DIR/wt.log}"
WT_BIN_DIR="$(dirname "$(readlink -f "$0")")"
WT_DEFAULT_AGENT="${WT_DEFAULT_AGENT:-opencode}"

# Colon-separated (PATH-style) list of directories the repo picker scans for
# git repos. If set, it fully replaces the built-in defaults below. Each entry
# is included if it is itself a primary repo, and its immediate children are
# scanned too (so e.g. WT_REPO_DIRS=$HOME/.config finds both a dotfiles repo at
# ~/.config and child repos like ~/.config/nvim).
WT_REPO_DIRS="${WT_REPO_DIRS:-$HOME/gt:$HOME/code:$HOME/projects:$HOME/src:$HOME/dev:$HOME/work:$HOME/workspace:$HOME/repos}"

# wt-state binary: authoritative SQLite-backed session store. Prefer a sibling
# of this script (handles both repo checkout and ~/bin symlink install); fall
# back to PATH.
WT_STATE="${WT_STATE:-$WT_BIN_DIR/wt-state}"
[[ -x "$WT_STATE" ]] || WT_STATE="wt-state"

# Opt-in vim-style modal keybindings for fzf pickers. Off by default; enable
# with `export WT_FZF_VIM=1`.
WT_FZF_VIM="${WT_FZF_VIM:-0}"

# Live nvim diff view. On by default: each worktree session's nvim boots into
# a diff of the branch vs its base and a watcher keeps it current. Disable with
# `export WT_DIFF_VIEW=0`. Sockets live under WT_STATUS_DIR so the test/staging
# harnesses stay isolated.
WT_DIFF_VIEW="${WT_DIFF_VIEW:-1}"
WT_NVIM_SOCK_DIR="${WT_NVIM_SOCK_DIR:-$WT_STATUS_DIR/nvim-sockets}"

# Which nvim diff plugin the live view uses: "unified" (unified.nvim, inline
# unified diff) or "diffview" (diffview.nvim, side-by-side). Passed to
# wt-diff.lua via the environment; it degrades to a plain editor if the chosen
# plugin isn't installed.
WT_DIFF_TOOL="${WT_DIFF_TOOL:-unified}"

# How long (seconds) a cached PR state stays fresh before `wt ls`/`pick` refetch
# it from `gh`. Warm calls within the TTL make zero network calls. Set to 0 to
# always refetch, or a large value to effectively pin the cache.
WT_PR_TTL="${WT_PR_TTL:-900}"

# Ensure directories exist
mkdir -p "$WT_BASE_DIR" "$WT_STATUS_DIR" "$WT_CONFIG_DIR"

# -----------------------------------------------------------------------------
#  Live diff view helpers
# -----------------------------------------------------------------------------

# Print the merge-base of HEAD against the branch's base, or "HEAD" if it can't
# be resolved. Prints nothing when there's no worktree to diff (master/adopted
# sessions). Uses the same base resolution as preview_pane — the branch's stored
# wtBase if it still resolves, else origin's default head — so the live diff
# view and the preview diffstat agree on what "the base" is.
diff_merge_base() {
    local wt_path="$1" branch base_ref
    [[ -n "$wt_path" && -e "$wt_path/.git" ]] || return 0
    branch=$(git -C "$wt_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    base_ref=$(git -C "$wt_path" config "branch.${branch}.wtBase" 2>/dev/null || true)
    if [[ -z "$base_ref" ]] || ! git -C "$wt_path" rev-parse --verify -q "${base_ref}^{commit}" >/dev/null 2>&1; then
        base_ref=$(git -C "$wt_path" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)
        base_ref=${base_ref#refs/remotes/}
        [[ -n "$base_ref" ]] || base_ref="origin/main"
    fi
    git -C "$wt_path" merge-base HEAD "$base_ref" 2>/dev/null || echo HEAD
}

# Path to a session's nvim RPC listen socket.
nvim_socket_path() { printf '%s/%s.sock' "$WT_NVIM_SOCK_DIR" "$1"; }

# Launch nvim in pane 0 of the session's main window. With the diff view enabled
# (WT_DIFF_VIEW=1) and nvim present, nvim listens on a per-session socket, boots
# into diffview.nvim against the branch base, and a file watcher keeps it live.
# Falls back to a plain `nvim` otherwise.
launch_nvim() {
    local session_name="$1" wt_path="$2"

    if [[ "$WT_DIFF_VIEW" != "1" ]] || ! command -v nvim >/dev/null 2>&1; then
        tmux send-keys -t "$session_name:main" "nvim" Enter
        return
    fi

    local sock base lua cmd
    sock=$(nvim_socket_path "$session_name")
    mkdir -p "$WT_NVIM_SOCK_DIR"
    rm -f "$sock"
    base=$(diff_merge_base "$wt_path")
    lua="$WT_BIN_DIR/../config/wt-diff.lua"

    # WT_DIFF_BASE / WT_DIFF_TOOL are read by wt-diff.lua on VimEnter to pick
    # the plugin and open the diff.
    cmd=$(printf 'WT_DIFF_BASE=%q WT_DIFF_TOOL=%q nvim --listen %q -c %q' \
                 "$base" "$WT_DIFF_TOOL" "$sock" "luafile $lua")
    tmux send-keys -t "$session_name:main" "$cmd" Enter

    # Watcher: refreshes the view on file changes. Only meaningful when there's
    # a diffable worktree; it self-exits when the socket disappears.
    if [[ -n "$base" ]]; then
        nohup "$WT_BIN_DIR/wt-diff-watch" "$sock" "$wt_path" >/dev/null 2>&1 &
        tmux set-option -qt "$session_name" @wt-diff-pid "$!"
    fi
}

# Stop a session's diff-view watcher and remove its socket. Read @wt-diff-pid
# before killing the tmux session, since the option vanishes with it.
stop_diff_view() {
    local session_name="$1" diff_pid
    diff_pid=$(tmux show-option -qv -t "$session_name" @wt-diff-pid 2>/dev/null || true)
    [[ -n "$diff_pid" ]] && kill "$diff_pid" 2>/dev/null || true
    rm -f "$(nvim_socket_path "$session_name")"
}

# -----------------------------------------------------------------------------
#  Vim-style modal keybindings for fzf (opt-in via WT_FZF_VIM=1)
# -----------------------------------------------------------------------------
# fzf has no native modal mode, so we emulate one with unbind/rebind. Pickers
# open in NORMAL mode: hjkl navigate and typing does not filter. Press i/a// to
# enter INSERT mode (type to filter); Esc returns to NORMAL. The prompt shows
# "[N] " in normal mode and "> " in insert mode.
#
# Every picker splices "${WT_FZF_VIM_ARGS[@]}" into its fzf call; the array is
# empty (a no-op) unless WT_FZF_VIM is enabled.
WT_FZF_VIM_ARGS=()
build_fzf_vim_binds() {
    [[ "$WT_FZF_VIM" == 1 || "$WT_FZF_VIM" == true ]] || return 0

    # Letters with a normal-mode action of their own — excluded from the blanket
    # "ignore" suppression below so their bindings aren't clobbered.
    local nav=" i a j k l h g G q "
    local c

    # Keys released in INSERT mode (so they type) and re-suppressed on Esc: every
    # printable key that can appear in a query — alnum plus the punctuation found
    # in branch/session names.
    local toggle=''
    for c in {a..z} {A..Z} {0..9}; do toggle+="$c,"; done
    toggle+='/,-,_,.'

    local nb=''
    # Suppress every non-nav printable key in NORMAL mode.
    for c in {a..z} {A..Z} {0..9}; do
        [[ "$nav" == *" $c "* ]] && continue
        nb+="$c:ignore,"
    done
    nb+='-:ignore,_:ignore,.:ignore,'
    # Navigation. (Ctrl-d/Ctrl-u are intentionally left to fzf's defaults so they
    # keep working in insert mode and don't collide with pick_worktree's Ctrl-d.)
    nb+='j:down,k:up,g:first,G:last,h:abort,l:accept,q:abort,'
    # Enter INSERT: release the toggle keys, arm Esc to return, flip the prompt.
    nb+="i:unbind($toggle)+rebind(esc)+change-prompt(> ),"
    nb+="a:unbind($toggle)+rebind(esc)+change-prompt(> ),"
    nb+="/:unbind($toggle)+rebind(esc)+change-prompt(> ),"
    # Esc (armed only in INSERT): re-suppress toggle keys, disarm itself so a
    # second Esc aborts as usual, restore the prompt.
    nb+="esc:rebind($toggle)+unbind(esc)+change-prompt([N] ),"
    # Start in NORMAL: Esc disarmed (aborts), normal-mode prompt.
    nb+='start:unbind(esc)+change-prompt([N] )'

    WT_FZF_VIM_ARGS=(--bind "$nb")
}
build_fzf_vim_binds

# -----------------------------------------------------------------------------
#  Agent Profiles
# -----------------------------------------------------------------------------
agent_binary() {
    case "$1" in
        claude) echo "claude" ;;
        codex)  echo "codex" ;;
        gemini) echo "gemini" ;;
        opencode) echo "opencode" ;;
        *)      echo "$1" ;;
    esac
}

agent_label() {
    case "$1" in
        claude) echo "Claude" ;;
        codex)  echo "Codex" ;;
        gemini) echo "Gemini" ;;
        opencode) echo "opencode" ;;
        *)      echo "$1" ;;
    esac
}

available_agents() {
    for agent in claude codex gemini opencode; do
        local bin
        bin=$(agent_binary "$agent")
        if command -v "$bin" &>/dev/null; then
            echo "$agent"
        fi
    done
}

# -----------------------------------------------------------------------------
#  Logging
# -----------------------------------------------------------------------------
log() {
    echo "[$(date '+%H:%M:%S')] wt: $*" >> "$WT_LOG_FILE"
}

# Log errors on exit
trap 'log "EXIT code=$? line=$LINENO cmd=$BASH_COMMAND"' ERR

# -----------------------------------------------------------------------------
#  Cross-Platform Helpers
# -----------------------------------------------------------------------------
clipboard_copy() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        pbcopy
    else
        if command -v wl-copy &>/dev/null; then
            wl-copy
        else
            xclip -selection clipboard
        fi
    fi
}

shell_quote() {
    printf "%q" "$1"
}

# Check for required commands
check_deps() {
    local missing=()
    for cmd in git tmux fzf; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Missing required commands: ${missing[*]}"
        echo "Install with:"
        if [[ "$OSTYPE" == "darwin"* ]]; then
            echo "  brew install ${missing[*]}"
        else
            echo "  pacman -S ${missing[*]}  # or yay for AUR packages"
        fi
        exit 1
    fi
}

# Sync env files from primary repo to worktree using .wt/sync config
# Format: one entry per line — "symlink <path>" or "copy <path>"
sync_env_files() {
    local repo_path="$1"
    local wt_path="$2"

    [[ "$wt_path" == "$repo_path" ]] && return 0

    local sync_config="$repo_path/.wt/sync"
    [[ -f "$sync_config" ]] || return 0

    local count=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// }" ]] && continue

        local action file
        action=$(awk '{print $1}' <<< "$line")
        file=$(awk '{print $2}' <<< "$line")

        local src="$repo_path/$file"
        local dst="$wt_path/$file"

        if [[ ! -f "$src" ]]; then
            echo "  [sync] skipping $file (not found in primary repo)"
            continue
        fi
        [[ -e "$dst" ]] && continue

        mkdir -p "$(dirname "$dst")"

        case "$action" in
            symlink) ln -s "$src" "$dst"; echo "  [sync] → $file" ;;
            copy)    cp "$src" "$dst";    echo "  [sync] ⊕ $file" ;;
            *)       echo "  [sync] unknown action '$action' for $file"; continue ;;
        esac
        (( count++ )) || true
    done < "$sync_config"

    [[ $count -gt 0 ]] && log "Synced $count env file(s) from $repo_path"
    return 0
}

# Apply allowed tools from ~/.config/wt/claude-allowed-tools.json
# Merges into <dir>/.claude/settings.local.json (preserving existing keys)
apply_allowed_tools() {
    local target_dir="$1"
    local tools_file="$WT_CONFIG_DIR/claude-allowed-tools.json"

    [[ -f "$tools_file" ]] || return 0

    local settings_dir="$target_dir/.claude"
    local settings_file="$settings_dir/settings.local.json"
    mkdir -p "$settings_dir"

    if [[ -f "$settings_file" ]]; then
        # Merge: add/replace permissions.allow, preserve everything else
        python3 -c "
import json, sys
with open(sys.argv[1]) as f: settings = json.load(f)
with open(sys.argv[2]) as f: tools = json.load(f)
settings.setdefault('permissions', {})['allow'] = tools
with open(sys.argv[1], 'w') as f: json.dump(settings, f, indent=2); f.write('\n')
" "$settings_file" "$tools_file"
    else
        # Create new settings file with just permissions.allow
        python3 -c "
import json, sys
with open(sys.argv[1]) as f: tools = json.load(f)
with open(sys.argv[2], 'w') as f: json.dump({'permissions': {'allow': tools}}, f, indent=2); f.write('\n')
" "$tools_file" "$settings_file"
    fi
    log "Applied allowed tools → $settings_file"
}

ensure_mcp_profile() {
    local target_dir="$1"
    local profile_name="$2"
    local target_mcp="$target_dir/.mcp.json"

    if [[ -f "$target_mcp" ]]; then
        echo "$target_mcp"
        return 0
    fi

    local mcp_profile="$WT_CONFIG_DIR/mcp-profiles/${profile_name}.json"
    if [[ -f "$mcp_profile" ]]; then
        cp "$mcp_profile" "$target_mcp"
        log "Copied MCP profile: $profile_name → $target_mcp"
        echo "$target_mcp"
    fi
}

write_opencode_mcp_config() {
    local source_file="$1"
    local output_file="$2"

    [[ -f "$source_file" ]] || return 1
    mkdir -p "$(dirname "$output_file")"

    python3 - "$source_file" "$output_file" <<'PY'
import json
import os
import sys

source, output = sys.argv[1], sys.argv[2]

with open(source) as f:
    config = json.load(f)


def as_command(value, args):
    if isinstance(value, list):
        command = list(value)
    else:
        command = [value]
    if isinstance(args, list):
        command.extend(args)
    return command


def convert_server(server):
    server = dict(server)
    server_type = server.get("type")

    if "url" in server:
        converted = {"type": "remote", "url": server["url"]}
        for key in ("enabled", "headers", "oauth", "timeout"):
            if key in server:
                converted[key] = server[key]
        return converted

    if "command" in server:
        converted = {
            "type": "local",
            "command": as_command(server["command"], server.get("args")),
        }
        environment = server.get("environment", server.get("env"))
        if environment is not None:
            converted["environment"] = environment
        for key in ("enabled", "timeout"):
            if key in server:
                converted[key] = server[key]
        return converted

    if server_type in ("http", "sse"):
        server["type"] = "remote"
    elif server_type == "stdio":
        server["type"] = "local"
        if "env" in server and "environment" not in server:
            server["environment"] = server.pop("env")
    return server


if isinstance(config.get("mcp"), dict):
    mcp = config["mcp"]
else:
    servers = config.get("mcpServers", {})
    mcp = {name: convert_server(server) for name, server in servers.items()}

if not mcp:
    sys.exit(2)

os.makedirs(os.path.dirname(output), exist_ok=True)
with open(output, "w") as f:
    json.dump({"$schema": "https://opencode.ai/config.json", "mcp": mcp}, f, indent=2)
    f.write("\n")
PY
}

configure_mcp_profile() {
    local target_dir="$1"
    local agent="$2"
    local profile_name="$3"
    local session_name="$4"

    local mcp_file
    mcp_file=$(ensure_mcp_profile "$target_dir" "$profile_name" || true)

    if [[ "$agent" == "opencode" && -n "$mcp_file" ]]; then
        local opencode_config="$WT_CONFIG_DIR/opencode-mcp/${session_name}.json"
        if write_opencode_mcp_config "$mcp_file" "$opencode_config"; then
            log "Generated opencode MCP config: $opencode_config"
            echo "$opencode_config"
        fi
    fi
}

derive_status_metadata() {
    local session_name="$1"

    if tmux has-session -t "$session_name" 2>/dev/null; then
        [[ -z "$repo" ]] && repo=$(tmux show-option -qv -t "$session_name" @wt-repo 2>/dev/null || true)
        [[ -z "$branch" ]] && branch=$(tmux show-option -qv -t "$session_name" @wt-branch 2>/dev/null || true)
        [[ -z "$wt_path" ]] && wt_path=$(tmux show-option -qv -t "$session_name" @wt-wt-path 2>/dev/null || true)
        [[ -z "$agent" ]] && agent=$(tmux show-option -qv -t "$session_name" @wt-agent 2>/dev/null || true)
        [[ -z "$opencode_config" ]] && opencode_config=$(tmux show-option -qv -t "$session_name" @wt-opencode-config 2>/dev/null || true)
    fi

    if [[ -n "$wt_path" && -d "$wt_path" ]]; then
        if [[ -z "$branch" ]]; then
            branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || true)
        fi
        if [[ -z "$repo" ]]; then
            if [[ "$wt_path" == "$WT_BASE_DIR"/* ]]; then
                local rel_path="${wt_path#$WT_BASE_DIR/}"
                repo="${rel_path%%/*}"
            else
                repo=$(basename "$(git -C "$wt_path" rev-parse --show-toplevel 2>/dev/null || echo "$wt_path")")
            fi
        fi
    fi

    if [[ -z "$repo" || -z "$branch" || -z "$wt_path" ]]; then
        local repo_dir candidate candidate_repo candidate_branch candidate_session
        for repo_dir in "$WT_BASE_DIR"/*; do
            [[ -d "$repo_dir" ]] || continue
            for candidate in "$repo_dir"/*; do
                [[ -d "$candidate" ]] || continue
                [[ -d "$candidate/.git" || -f "$candidate/.git" ]] || continue
                candidate_branch=$(git -C "$candidate" branch --show-current 2>/dev/null || true)
                [[ -n "$candidate_branch" ]] || candidate_branch="detached"
                candidate_repo=$(basename "$repo_dir")
                candidate_session="${candidate_repo}-${candidate_branch//\//-}"
                if [[ "$candidate_session" == "$session_name" ]]; then
                    [[ -z "$repo" ]] && repo="$candidate_repo"
                    [[ -z "$branch" ]] && branch="$candidate_branch"
                    [[ -z "$wt_path" ]] && wt_path="$candidate"
                    break 2
                fi
            done
        done
    fi

    [[ -z "$agent" ]] && agent="$WT_DEFAULT_AGENT"
    if [[ "$agent" == "opencode" && -z "$opencode_config" ]]; then
        local default_opencode_config="$WT_CONFIG_DIR/opencode-mcp/${session_name}.json"
        if [[ -f "$default_opencode_config" ]]; then
            opencode_config="$default_opencode_config"
        fi
    fi
}

# -----------------------------------------------------------------------------
#  Status Tracking
# -----------------------------------------------------------------------------
# Populate status/message/repo/branch/wt_path/pr/agent/opencode_config from the
# store for a session. Returns 1 if the session has no row yet. Values are read
# as data via jq @sh (shell-quoted), never sourced, so messages can't execute.
load_session() {
    local name="$1" json
    json=$("$WT_STATE" get "$name" --json 2>/dev/null) || return 1
    eval "$(jq -r '{status,message,repo,branch,wt_path,pr,agent,opencode_config,pr_state,pr_state_checked_at}
                   | to_entries[] | "\(.key)=\(.value|@sh)"' <<<"$json")"
}

# Persist the current status/* vars for a session (full overwrite). Relies on
# bash dynamic scoping: the caller's locals are visible here.
save_session() {
    local name="$1"
    "$WT_STATE" set "$name" \
        --status "${status:-}" --message "${message:-}" \
        --repo "${repo:-}" --branch "${branch:-}" --wt-path "${wt_path:-}" \
        --pr "${pr:-}" --agent "${agent:-}" \
        --opencode-config "${opencode_config:-}" >/dev/null
}

set_status() {
    local session_name="$1"
    local status="$2"  # idle, working, input, error
    local message="${3:-}"

    local new_status="$status"
    local new_message="$message"

    # Preserve existing metadata fields if the session already has a row
    local pr="" repo="" branch="" wt_path="" agent="" opencode_config=""
    local pr_state="" pr_state_checked_at=""  # populated by load_session; not re-saved here
    load_session "$session_name" || true
    status="$new_status"
    message="$new_message"
    derive_status_metadata "$session_name"

    save_session "$session_name"

    # Write tmux user options for live display
    if tmux has-session -t "$session_name" 2>/dev/null; then
        local icon
        icon=$(get_status_icon "$status")
        tmux set-option -qt "$session_name" @wt-status  "$status"
        tmux set-option -qt "$session_name" @wt-icon    "$icon"
        tmux set-option -qt "$session_name" @wt-message "$message"
        tmux set-option -qt "$session_name" @wt-repo    "$repo"
        tmux set-option -qt "$session_name" @wt-branch  "$branch"
        tmux set-option -qt "$session_name" @wt-wt-path "$wt_path"
        tmux set-option -qt "$session_name" @wt-agent   "$agent"
        tmux set-option -qt "$session_name" @wt-opencode-config "$opencode_config"
        if [[ -n "$opencode_config" ]]; then
            tmux set-environment -t "$session_name" OPENCODE_CONFIG "$opencode_config"
        fi
        tmux refresh-client -S 2>/dev/null || true
    fi
}

get_status() {
    "$WT_STATE" get "$1" --field status 2>/dev/null || echo "unknown"
}

get_status_icon() {
    local status="$1"
    case "$status" in
        working) echo "●" ;;
        idle)    echo "○" ;;
        input)   echo "⊘" ;;
        error)   echo "✗" ;;
        *)       echo "?" ;;
    esac
}

# ANSI-colored icon for terminal output (list, pick commands)
get_status_icon_ansi() {
    local status="$1"
    case "$status" in
        working) echo -e "\033[32m●\033[0m" ;;  # green
        idle)    echo -e "\033[34m○\033[0m" ;;  # blue
        input)   echo -e "\033[33m⊘\033[0m" ;;  # yellow
        error)   echo -e "\033[31m✗\033[0m" ;;  # red
        *)       echo -e "\033[90m?\033[0m" ;;  # gray
    esac
}

# -----------------------------------------------------------------------------
#  PR State (GitHub, gh-only, cached in the store)
# -----------------------------------------------------------------------------
# Resolve the GitHub PR state for a branch. Echoes one of
# merged|open|closed|draft|none, or nothing when gh is unavailable/offline or
# the path isn't a GitHub repo — callers treat empty as "don't know yet, retry
# on the next TTL" and never cache it. Reusable primitive: a future `wt sweep`
# calls this to find worktrees whose PR has merged.
pr_state_lookup() {
    local branch="$1" wt_path="$2"
    [[ -n "$branch" && -n "$wt_path" && -d "$wt_path" ]] || return 0
    command -v gh &>/dev/null || return 0

    # --state all so a merged/closed PR still resolves. `gh pr list` prints a
    # JSON array and exits 0 even when empty, which lets us tell "no PR for this
    # branch" (empty array) apart from a gh/network error (non-zero exit).
    local json
    json=$(cd "$wt_path" && gh pr list --head "$branch" --state all \
             --json state,isDraft --limit 1 2>/dev/null) || return 0
    [[ -n "$json" ]] || return 0

    local state draft
    state=$(jq -r '.[0].state // "none"' <<<"$json" 2>/dev/null) || return 0
    draft=$(jq -r '.[0].isDraft // false' <<<"$json" 2>/dev/null)
    case "$state" in
        MERGED) echo "merged" ;;
        CLOSED) echo "closed" ;;
        OPEN)   [[ "$draft" == "true" ]] && echo "draft" || echo "open" ;;
        none)   echo "none" ;;
    esac
}

# Colored one-glyph badge for a PR state, for the ls/pick surfaces. Empty string
# for none/unknown so worktrees without a PR stay visually quiet.
pr_badge() {
    case "$1" in
        merged) echo -e "\033[35m⬤\033[0m" ;;  # magenta — merged
        open)   echo -e "\033[32m◆\033[0m" ;;  # green — open
        draft)  echo -e "\033[90m◇\033[0m" ;;  # gray — draft
        closed) echo -e "\033[31m⊘\033[0m" ;;  # red — closed, not merged
        *)       echo "" ;;
    esac
}

# True (stale) when a cached PR state is missing, malformed, or older than the
# TTL and should be refetched from gh.
is_pr_stale() {
    local checked="${1:-0}"
    [[ "$checked" =~ ^[0-9]+$ ]] || return 0
    (( checked == 0 )) && return 0
    local now
    now=$(date +%s)
    (( now - checked >= WT_PR_TTL ))
}

# Refresh cached PR states for the given "session<TAB>branch<TAB>wt_path" lines,
# persisting each to the store. Runs detached and in parallel so the caller
# (wt ls / pick) never blocks on the network; refreshed badges surface on the
# next render. stdin/stdout/stderr are redirected so a backgrounded refresh can't
# hold open a pipe the caller is reading from (e.g. `list_worktrees full | fzf`).
refresh_pr_states() {
    local lines="$1"
    [[ -n "$lines" ]] || return 0
    command -v gh &>/dev/null || return 0

    {
        local TAB session branch wt_path n=0
        TAB=$(printf '\t')
        while IFS="$TAB" read -r session branch wt_path; do
            [[ -n "$session" && -n "$wt_path" ]] || continue
            (
                local state
                state=$(pr_state_lookup "$branch" "$wt_path")
                [[ -n "$state" ]] && "$WT_STATE" set "$session" --pr-state "$state" >/dev/null 2>&1
            ) &
            # Cap concurrency so a large worktree list can't fork a gh storm.
            (( ++n % 8 == 0 )) && wait
        done <<<"$lines"
        wait
    } </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

# -----------------------------------------------------------------------------
#  Worktree Operations
# -----------------------------------------------------------------------------
# Get the bare repo path for a given repo
get_bare_repo() {
    local repo_path="$1"

    # If it's already a bare repo or worktree, find the main .git
    local git_dir
    git_dir=$(git -C "$repo_path" rev-parse --git-dir 2>/dev/null)

    if [[ "$git_dir" == *".git/worktrees/"* ]]; then
        # This is a worktree, get the common dir
        git -C "$repo_path" rev-parse --git-common-dir
    else
        echo "$git_dir"
    fi
}

# List all worktrees across all repos
# Render a single worktree row in the requested format (no trailing newline;
# rows are collected into an array, sorted by recency, then printed).
render_worktree_row() {
    local format="$1" session_name="$2" wt_path="$3" status="$4" repo="$5" branch="$6" pr_state="${7:-}"
    case "$format" in
        full)
            local icon badge
            icon=$(get_status_icon_ansi "${status:-unknown}")
            # One-char PR cell; a space keeps the wt_path column aligned across
            # rows even though the colored glyph and space differ in byte width.
            badge=$(pr_badge "$pr_state")
            [[ -n "$badge" ]] || badge=" "
            printf "%s %-20s %-25s %s %s" "$icon" "${repo:-?}" "${branch:-?}" "$badge" "${wt_path:-?}"
            ;;
        simple)  printf "%s:%s:%s" "$session_name" "${wt_path:-?}" "${status:-unknown}" ;;
        session) printf "%s" "$session_name" ;;
    esac
}

# List worktree sessions, most-recently-active first. Recency is the single
# ranking shared by every surface (wt ls, wt pick, the switcher): the store's
# updated_at is the source of truth, with directory mtime as a fallback for
# on-disk worktrees that were never tracked. Sorting requires buffering all
# rows, so the list appears once fully assembled rather than streaming in.
list_worktrees() {
    local format="${1:-full}"
    local seen_sessions=""
    local -a rows=()
    local stale_lines=""   # "session<TAB>branch<TAB>wt_path" per worktree needing a PR refresh
    local TAB
    TAB=$(printf '\t')

    # Fetch store metadata once. TSV columns:
    #   name status repo branch wt_path updated_at pr_state pr_state_checked_at
    local store_data
    store_data=$("$WT_STATE" list --no-master 2>/dev/null \
        | jq -r '.[] | [.name,.status,.repo,.branch,.wt_path,.updated_at,.pr_state,.pr_state_checked_at] | @tsv' || true)

    # Phase A: worktrees on disk under WT_BASE_DIR (authoritative for existence).
    if [[ -d "$WT_BASE_DIR" ]]; then
        while IFS= read -r -d '' wt_path; do
            [[ -d "$wt_path/.git" || -f "$wt_path/.git" ]] || continue
            local branch repo_name session_name srow status key pr_state pr_checked
            branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || echo "detached")
            repo_name=$(basename "$(dirname "$wt_path")")
            session_name="${repo_name}-${branch//\//-}"
            seen_sessions="${seen_sessions}:${session_name}:"
            # Exact field match (awk, not grep) so repo/branch names with regex
            # metacharacters like '.' or '+' can't false-match.
            srow=$(awk -F"$TAB" -v n="$session_name" '$1==n{print; exit}' <<<"$store_data")
            pr_state=""
            pr_checked=0
            if [[ -n "$srow" ]]; then
                status=$(cut -f2 <<<"$srow")
                key=$(cut -f6 <<<"$srow")
                pr_state=$(cut -f7 <<<"$srow")
                pr_checked=$(cut -f8 <<<"$srow")
            else
                status="unknown"
                key=$(stat -c %Y "$wt_path" 2>/dev/null || stat -f %m "$wt_path" 2>/dev/null || echo 0)
            fi
            if [[ "$format" == full ]] && is_pr_stale "$pr_checked"; then
                stale_lines+="${session_name}${TAB}${branch}${TAB}${wt_path}"$'\n'
            fi
            rows+=("${key:-0}${TAB}$(render_worktree_row "$format" "$session_name" "$wt_path" "$status" "$repo_name" "$branch" "$pr_state")")
        done < <(find "$WT_BASE_DIR" -maxdepth 2 -type d -print0 2>/dev/null)
    fi

    # Phase B: store sessions not found on disk (adopted/primary worktrees),
    # included only when a live tmux session exists.
    local name status repo branch wt_path updated_at pr_state pr_checked
    while IFS="$TAB" read -r name status repo branch wt_path updated_at pr_state pr_checked; do
        [[ -n "$name" ]] || continue
        [[ "$seen_sessions" == *":${name}:"* ]] && continue
        tmux has-session -t "$name" 2>/dev/null || continue
        if [[ "$format" == full && -n "$wt_path" ]] && is_pr_stale "$pr_checked"; then
            stale_lines+="${name}${TAB}${branch}${TAB}${wt_path}"$'\n'
        fi
        rows+=("${updated_at:-0}${TAB}$(render_worktree_row "$format" "$name" "${wt_path:-?}" "${status:-unknown}" "${repo:-?}" "${branch:-?}" "$pr_state")")
    done <<<"$store_data"

    # Kick off a detached, parallel refresh of any stale PR states so badges are
    # warm on the next render; this never blocks the listing below.
    [[ "$format" == full ]] && refresh_pr_states "$stale_lines"

    # Emit most-recently-active first, then strip the leading recency key.
    [[ ${#rows[@]} -gt 0 ]] || return 0
    printf '%s\n' "${rows[@]}" | sort -t"$TAB" -k1,1nr -s | cut -f2-
}

# Create a new worktree and tmux session
create_worktree() {
    local repo_path="$1"
    local branch="$2"
    local start_agent="${3:-false}"
    local task="${4:-}"
    local base_branch="${5:-}"
    local agent="${6:-$WT_DEFAULT_AGENT}"
    local switch_after="${7:-false}"  # only steal the client's focus when asked

    # Resolve to absolute path
    repo_path=$(cd "$repo_path" && pwd)
    local repo_name
    repo_name=$(basename "$repo_path")

    # Sanitize branch name for directory/session name
    local safe_branch="${branch//\//-}"
    local wt_path="$WT_BASE_DIR/$repo_name/$safe_branch"
    local session_name="${repo_name}-${safe_branch}"

    # Check if worktree already exists on disk
    if [[ -d "$wt_path" ]] && tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Worktree already exists at $wt_path"
        [[ "$switch_after" == "true" ]] && switch_to "$session_name"
        return
    fi

    # Resolve worktree path (create if needed, adopt if exists elsewhere)
    if [[ ! -d "$wt_path" ]]; then
        echo "Creating worktree for $repo_name @ $branch..."
        mkdir -p "$(dirname "$wt_path")"

        # Check if branch is already checked out somewhere
        local existing_wt
        existing_wt=$(git -C "$repo_path" worktree list --porcelain 2>/dev/null | grep -B2 "branch refs/heads/$branch$" | head -1 | sed 's/^worktree //' || true)
        if [[ -n "$existing_wt" && "$existing_wt" != "$repo_path" ]]; then
            # Adopt existing worktree (not the primary repo)
            echo "Branch '$branch' already checked out at: $existing_wt"
            echo "Adopting existing checkout..."
            wt_path="$existing_wt"
        elif [[ -n "$existing_wt" && "$existing_wt" == "$repo_path" ]]; then
            # Branch is checked out at the primary repo — use it directly
            echo "Branch '$branch' is the primary checkout — using $repo_path directly."
            wt_path="$repo_path"
        elif git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
            git -C "$repo_path" worktree add "$wt_path" "$branch"
        else
            # Branch doesn't exist — create from the base. Prefer the remote-
            # tracking ref (origin/<base>), fall back to a local branch of that
            # name, else current HEAD. This accepts either a remote default like
            # "main" or a local-only base picked interactively.
            local base_ref="HEAD"
            if [[ -n "$base_branch" ]]; then
                if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$base_branch" 2>/dev/null; then
                    base_ref="origin/$base_branch"
                elif git -C "$repo_path" show-ref --verify --quiet "refs/heads/$base_branch" 2>/dev/null; then
                    base_ref="$base_branch"
                else
                    base_ref="origin/$base_branch"  # let git report the error clearly
                fi
            fi
            echo "Creating branch '$branch' from $base_ref..."
            git -C "$repo_path" worktree add -b "$branch" "$wt_path" "$base_ref"
            # Remember the fork point so the picker preview can diff against the
            # branch's real base (not just origin's default head). Skipped for
            # HEAD-based branches, where origin's default head is the best guess.
            [[ "$base_ref" != "HEAD" ]] && \
                git -C "$wt_path" config "branch.${branch}.wtBase" "$base_ref" 2>/dev/null || true
        fi
    else
        echo "Worktree exists at $wt_path, recreating session..."
    fi

    # Create tmux session
    echo "Creating tmux session: $session_name"

    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Session already exists, attaching..."
    else
        local opencode_config=""
        opencode_config=$(configure_mcp_profile "$wt_path" "$agent" "default" "$session_name" || true)

        # Apply default-allowed tools for Claude sessions
        if [[ "$agent" == "claude" ]]; then
            apply_allowed_tools "$wt_path"
        fi

        # Sync env files from primary repo (.wt/sync)
        sync_env_files "$repo_path" "$wt_path"

        # Create session with main window (nvim left, agent right)
        tmux new-session -d -s "$session_name" -c "$wt_path" -n main

        # Start nvim in the left pane (boots into the live diff view)
        launch_nvim "$session_name" "$wt_path"

        # Split right for agent pane
        tmux split-window -h -t "$session_name:main" -c "$wt_path"

        # Create shell window
        tmux new-window -t "$session_name" -n shell -c "$wt_path"

        # Select agent pane (right pane of main window)
        tmux select-window -t "$session_name:main"
        tmux select-pane -t "$session_name:main.1"

        local agent_display
        agent_display=$(agent_label "$agent")

        # Persist initial session state with full metadata
        status=idle
        message=Ready
        repo=$repo_name
        pr=
        save_session "$session_name"

        # Set tmux session options (status + metadata)
        tmux set-option -qt "$session_name" @wt-status  "idle"
        tmux set-option -qt "$session_name" @wt-icon    "○"
        tmux set-option -qt "$session_name" @wt-message "Ready"
        tmux set-option -qt "$session_name" @wt-repo    "$repo_name"
        tmux set-option -qt "$session_name" @wt-branch  "$branch"
        tmux set-option -qt "$session_name" @wt-wt-path "$wt_path"
        tmux set-option -qt "$session_name" @wt-pr      ""
        tmux set-option -qt "$session_name" @wt-master  "0"
        tmux set-option -qt "$session_name" @wt-agent   "$agent"
        tmux set-option -qt "$session_name" @wt-opencode-config "$opencode_config"
        if [[ -n "$opencode_config" ]]; then
            tmux set-environment -t "$session_name" OPENCODE_CONFIG "$opencode_config"
        else
            tmux set-environment -u -t "$session_name" OPENCODE_CONFIG 2>/dev/null || true
        fi

        # Wait for nvim/claudecode.nvim to start WebSocket server
        echo "Waiting for Neovim IDE server to start..."
        sleep 2

        # Start agent via wt-agent-launch
        if [[ "$start_agent" == "true" ]]; then
            if [[ -n "$task" ]]; then
                tmux send-keys -t "$session_name:main.1" "$WT_BIN_DIR/wt-agent-launch \"$task\"" Enter
            else
                tmux send-keys -t "$session_name:main.1" "$WT_BIN_DIR/wt-agent-launch" Enter
            fi
            set_status "$session_name" "working" "${task:-Interactive session}"
        else
            # Start agent for when user wants it
            tmux send-keys -t "$session_name:main.1" "$WT_BIN_DIR/wt-agent-launch" Enter
        fi
    fi

    # Switch to the session only when explicitly asked (e.g. `wt new --switch`
    # or the "New + open" menu entry). By default we create in the background so
    # spinning up several worktrees never yanks your current view.
    if [[ "$switch_after" == "true" ]]; then
        switch_to "$session_name"
    else
        echo "Created session '$session_name' (still here — 'wt pick' or prefix+W to open it)"
    fi
}

# Switch to a worktree session
switch_to() {
    local session_name="$1"

    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Session '$session_name' does not exist"
        return 1
    fi

    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

# Delete a worktree and its session
delete_worktree() {
    local session_name="$1"
    local force="${2:-false}"

    # Find the worktree path
    local wt_info
    wt_info=$(list_worktrees simple | grep "^${session_name}:" || true)

    if [[ -z "$wt_info" ]]; then
        echo "Worktree session '$session_name' not found"
        return 1
    fi

    local wt_path
    wt_path=$(echo "$wt_info" | cut -d: -f2)

    if [[ "$force" != "true" ]]; then
        read -p "Delete worktree at $wt_path and session $session_name? [y/N] " confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo "Cancelled"
            return
        fi
    fi

    # Stop the diff-view watcher (reads @wt-diff-pid) before the session dies.
    stop_diff_view "$session_name"

    # Kill tmux session
    if tmux has-session -t "$session_name" 2>/dev/null; then
        tmux kill-session -t "$session_name"
    fi

    # Remove worktree
    if [[ -d "$wt_path" ]]; then
        local repo_git_dir
        repo_git_dir=$(git -C "$wt_path" rev-parse --git-common-dir 2>/dev/null || true)

        if [[ -n "$repo_git_dir" ]]; then
            git -C "$(dirname "$repo_git_dir")" worktree remove "$wt_path" --force
        else
            rm -rf "$wt_path"
        fi
    fi

    # Remove session state
    "$WT_STATE" delete "$session_name" >/dev/null 2>&1 || true
    rm -f "$WT_CONFIG_DIR/opencode-mcp/${session_name}.json"

    echo "Deleted: $session_name"
}

# -----------------------------------------------------------------------------
#  Interactive Repo/Branch Pickers (fzf-based)
# -----------------------------------------------------------------------------

# Find git repos in common locations (depth 1 only for clean list)
find_git_repos() {
    local search_dirs=()
    IFS=':' read -r -a search_dirs <<< "$WT_REPO_DIRS"

    for dir in "${search_dirs[@]}"; do
        [[ -n "$dir" && -d "$dir" ]] || continue
        # A primary repo has .git as a directory; a worktree has .git as a file,
        # which we skip. Include the search dir itself if it is a primary repo
        # (e.g. a dotfiles repo at ~/.config), then list primary-repo children.
        [[ -d "$dir/.git" ]] && echo "${dir%/}"
        for child in "$dir"/*/; do
            [[ -d "$child/.git" ]] && echo "${child%/}"
        done
    done
}

# Interactive repo picker
pick_repo() {
    check_deps

    local repos
    repos=$(find_git_repos | sort -u)

    if [[ -z "$repos" ]]; then
        echo "No git repos found in common locations" >&2
        echo "Enter repo path manually (empty to cancel):" >&2
        local repo_path=""
        IFS= read -r repo_path </dev/tty || return 130
        [[ -n "$repo_path" ]] || return 130
        echo "$repo_path"
        return 0
    fi

    # Candidates come from the pipe; fzf opens /dev/tty for its UI itself. Do
    # not redirect stdin from /dev/tty here — that would override the pipe and
    # feed fzf an empty candidate list. Capture fzf's exit status so `set -e`
    # can't kill us on Esc (exit 130); we translate that into a clean cancel.
    local sel rc=0
    sel=$(echo "$repos" | fzf \
        "${WT_FZF_VIM_ARGS[@]}" \
        --header="Select repository" \
        --preview='
            echo "=== Branches ==="
            git -C {} branch --list | head -10
            echo ""
            echo "=== Recent commits ==="
            git -C {} log --oneline -5 2>/dev/null
        ' \
        --preview-window=right:50%) || rc=$?
    if (( rc != 0 )); then return 130; fi
    printf '%s\n' "$sel"
}

# Resolve a repo's default branch. Emits a bare branch name (no origin/ prefix).
# Not every clone has origin/HEAD set (added remotes, shallow fetches, older
# clones), so we can't just trust the symbolic ref — we harden the fallback so
# the answer is correct on main-repos, master-repos, and anything else.
detect_default_branch() {
    local repo_path="$1"
    local def

    # 1. Remote HEAD, if the symbolic ref is populated locally.
    def=$(git -C "$repo_path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    if [[ -n "$def" ]]; then printf '%s\n' "$def"; return; fi

    # 2. Ask the remote to (re)populate origin/HEAD, then retry. We've usually
    #    just fetched, so this is cheap and authoritative.
    git -C "$repo_path" remote set-head origin --auto >/dev/null 2>&1 || true
    def=$(git -C "$repo_path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    if [[ -n "$def" ]]; then printf '%s\n' "$def"; return; fi

    # 3. Probe the usual suspects on the remote.
    local cand
    for cand in main master; do
        if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$cand" 2>/dev/null; then
            printf '%s\n' "$cand"; return
        fi
    done

    # 4. Fall back to the current HEAD's branch (or the literal 'main').
    def=$(git -C "$repo_path" branch --show-current 2>/dev/null)
    printf '%s\n' "${def:-main}"
}

# Interactive branch picker (shows existing + option to create new)
pick_branch() {
    local repo_path="$1"
    local default_branch="${2:-}"
    check_deps

    # Get all branches (local and remote)
    local branches
    branches=$(git -C "$repo_path" branch -a --format='%(refname:short)' 2>/dev/null | \
               sed 's|origin/||' | sort -u | grep -v '^HEAD$')

    # Add "create new" option at top. Capture fzf's exit so Esc (130) becomes a
    # clean cancel instead of a `set -e` death.
    local selection rc=0
    selection=$(echo -e "[+ Create new branch]\n$branches" | fzf \
        "${WT_FZF_VIM_ARGS[@]}" \
        --header="Select branch or create new" \
        --preview='
            branch="{}"
            if [[ "$branch" == "[+ Create new branch]" ]]; then
                echo "Type a new branch name after selecting this option"
            else
                repo_path="'"$repo_path"'"
                echo "=== Branch: $branch ==="
                git -C "$repo_path" log --oneline "$branch" -10 2>/dev/null || \
                git -C "$repo_path" log --oneline "origin/$branch" -10 2>/dev/null || \
                echo "Branch not yet created locally"
            fi
        ' \
        --preview-window=right:50%) || rc=$?
    if (( rc != 0 )); then return 130; fi

    if [[ "$selection" == "[+ Create new branch]" ]]; then
        # Read the name a keystroke at a time so Esc cancels cleanly — a plain
        # `read` would swallow it. Esc, or Enter on an empty line, aborts the
        # whole flow; any other first key begins the name.
        echo "" >&2
        printf 'Enter new branch name (Esc to cancel): ' >&2
        local first=""
        IFS= read -rsn1 first </dev/tty || return 130
        if [[ -z "$first" || "$first" == $'\e' ]]; then
            printf '\n' >&2
            return 130
        fi
        printf '%s' "$first" >&2          # echo the key -s consumed silently
        local rest=""
        IFS= read -r rest </dev/tty || true
        printf '\n' >&2
        local new_branch="$first$rest"

        # Guard against a whitespace-only name — otherwise we'd build a worktree
        # and tmux session named after nothing.
        new_branch="${new_branch#"${new_branch%%[![:space:]]*}"}"  # ltrim
        new_branch="${new_branch%"${new_branch##*[![:space:]]}"}"  # rtrim
        if [[ -z "$new_branch" ]]; then
            echo "Branch name cannot be empty." >&2
            return 130
        fi

        # Pick a base. The detected default is listed first so fzf lands on it —
        # Enter accepts it, Esc cancels the whole flow. Include remotes so
        # remote-only bases are selectable; awk keeps first-seen order (so the
        # default stays on top) while de-duping local/remote copies of a branch.
        local base_branch base_rc=0
        base_branch=$(
            {
                [[ -n "$default_branch" ]] && printf '%s\n' "$default_branch"
                git -C "$repo_path" branch -a --format='%(refname:short)' 2>/dev/null | sed 's|^origin/||'
            } | grep -vx 'HEAD' | grep -v '^$' | awk '!seen[$0]++' \
              | fzf "${WT_FZF_VIM_ARGS[@]}" \
                    --header="Select base branch (Enter = ${default_branch:-current HEAD}, Esc cancels)"
        ) || base_rc=$?
        if (( base_rc != 0 )); then return 130; fi
        printf '%s:%s\n' "$new_branch" "$base_branch"
    else
        echo "$selection"
    fi
}

# Interactive agent picker (fzf). Emits the chosen agent id on stdout. With one
# (or zero) agents installed there's nothing to choose, so it returns that agent
# without prompting. The default agent is listed first so it's preselected.
pick_agent() {
    local agents=() a
    while IFS= read -r a; do agents+=("$a"); done < <(available_agents)

    if [[ ${#agents[@]} -le 1 ]]; then
        printf '%s\n' "${agents[0]:-$WT_DEFAULT_AGENT}"
        return
    fi

    # Order the default first so fzf lands on it; show labels, return the id.
    local ordered=("$WT_DEFAULT_AGENT")
    for a in "${agents[@]}"; do
        [[ "$a" == "$WT_DEFAULT_AGENT" ]] || ordered+=("$a")
    done

    # Candidates come from the pipe; fzf opens /dev/tty for its UI itself. A
    # `</dev/tty` here would override the pipe and give fzf an empty list.
    # Capture fzf's exit before `cut` so Esc (130) survives pipefail and becomes
    # a clean cancel rather than silently falling back to the default agent.
    local raw rc=0
    raw=$(for a in "${ordered[@]}"; do
              local lbl; lbl=$(agent_label "$a")
              [[ "$a" == "$WT_DEFAULT_AGENT" ]] && lbl="$lbl (default)"
              printf '%s\t%s\n' "$a" "$lbl"
          done | fzf "${WT_FZF_VIM_ARGS[@]}" --delimiter='\t' --with-nth=2 --header="Select agent") || rc=$?
    if (( rc != 0 )); then return 130; fi
    printf '%s\n' "$(printf '%s' "$raw" | cut -f1)"
}

# Interactive new worktree creation
# Flow: pick repo → pick/create branch (based on origin/main) → create worktree
interactive_new() {
    local repo_path="${1:-}"
    local branch="${2:-}"
    local switch_after="${3:-false}"

    log "interactive_new start repo_path='$repo_path' branch='$branch'"

    # Step 1: Pick repo (fzf, with branch/commit preview)
    if [[ -z "$repo_path" ]]; then
        log "finding repos..."
        repo_path=$(pick_repo) || { echo "Cancelled."; return 1; }
        log "repo selection='$repo_path'"
    fi

    # Resolve to absolute path
    repo_path=$(cd "$repo_path" 2>/dev/null && pwd) || {
        echo "Invalid repo path: $repo_path"
        return 1
    }

    local repo_name
    repo_name=$(basename "$repo_path")

    # Step 2: Fetch latest from origin
    echo "Fetching latest from origin..."
    git -C "$repo_path" fetch origin 2>/dev/null || true

    # Detect default branch (remote HEAD, hardened for repos where it isn't set)
    local default_branch
    default_branch=$(detect_default_branch "$repo_path")

    # Step 3: Pick or create branch (fzf). pick_branch returns either an existing
    # branch, a new "branch", or "branch:base" when a base was chosen for a new
    # branch. Absent an explicit base we default to origin/$default_branch, the
    # flow's stated intent. base_branch is only consulted when the branch doesn't
    # exist yet, so passing it for an existing branch is harmless.
    local base_branch="$default_branch"
    if [[ -z "$branch" ]]; then
        local selection
        selection=$(pick_branch "$repo_path" "$default_branch") || { echo "Cancelled."; return 1; }
        log "branch selection='$selection'"

        branch="${selection%%:*}"
        if [[ "$selection" == *:* ]]; then
            base_branch="${selection#*:}"
        fi
    fi

    log "branch=$branch repo_path=$repo_path base_branch=$base_branch"

    # Step 4: Pick agent (fzf)
    local agent
    agent=$(pick_agent) || { echo "Cancelled."; return 1; }

    local agent_display
    agent_display=$(agent_label "$agent")

    echo ""
    echo "Creating worktree: $repo_name @ $branch (base: origin/$base_branch) [$agent_display]"
    create_worktree "$repo_path" "$branch" false "" "$base_branch" "$agent" "$switch_after"
}

# -----------------------------------------------------------------------------
#  Interactive Worktree Picker (fzf-based)
# -----------------------------------------------------------------------------
# Build rich pick list: session_name:display_string
pick_list() {
    while IFS=: read -r session_name wt_path sess_status; do
        # load_session populates agent/message/repo/branch (and re-sets wt_path
        # to the stored value); locals keep the extra fields from leaking.
        local agent="" message="" repo="" branch="" status="" pr="" opencode_config=""
        load_session "$session_name" || true
        local icon
        icon=$(get_status_icon "${sess_status:-unknown}")
        local label
        label=$(agent_label "${agent:-$WT_DEFAULT_AGENT}")
        echo "${session_name}:${wt_path}:${icon} ${sess_status:-?}  ${label}  ${repo:-?}@${branch:-?}  ${message:-}"
    done < <(list_worktrees simple)
}

revive_worktree_session() {
    local session_name="$1"
    local wt_path="$2"

    if [[ -z "$wt_path" || ! -d "$wt_path" ]]; then
        echo "Cannot revive '$session_name': worktree path not found"
        return 1
    fi

    local status="idle" message="Ready" repo="" branch="" pr="" agent="" opencode_config=""
    load_session "$session_name" || true
    wt_path="$2"  # the passed path is authoritative for revival, not the stored one

    branch="${branch:-$(git -C "$wt_path" branch --show-current 2>/dev/null || echo detached)}"
    if [[ -z "$repo" || "$repo" == "?" ]]; then
        repo=$(basename "$(dirname "$wt_path")")
    fi
    agent="${agent:-$WT_DEFAULT_AGENT}"

    echo "Reviving tmux session: $session_name"
    opencode_config=$(configure_mcp_profile "$wt_path" "$agent" "default" "$session_name" || true)
    if [[ "$agent" == "claude" ]]; then
        apply_allowed_tools "$wt_path"
    fi

    tmux new-session -d -s "$session_name" -c "$wt_path" -n main
    launch_nvim "$session_name" "$wt_path"
    tmux split-window -h -t "$session_name:main" -c "$wt_path"
    tmux new-window -t "$session_name" -n shell -c "$wt_path"
    tmux select-window -t "$session_name:main"
    tmux select-pane -t "$session_name:main.1"

    tmux set-option -qt "$session_name" @wt-status  "${status:-idle}"
    tmux set-option -qt "$session_name" @wt-message "${message:-Ready}"
    tmux set-option -qt "$session_name" @wt-repo    "$repo"
    tmux set-option -qt "$session_name" @wt-branch  "$branch"
    tmux set-option -qt "$session_name" @wt-pr      "$pr"
    tmux set-option -qt "$session_name" @wt-agent   "$agent"
    tmux set-option -qt "$session_name" @wt-opencode-config "$opencode_config"
    if [[ -n "$opencode_config" ]]; then
        tmux set-environment -t "$session_name" OPENCODE_CONFIG "$opencode_config"
    fi

    status="${status:-idle}"
    message="${message:-Ready}"
    save_session "$session_name"
}

# -----------------------------------------------------------------------------
#  Session preview (shared by the fzf pickers)
# -----------------------------------------------------------------------------
# Rendered inside fzf's preview subprocess. Args: session name, worktree path.
# The live agent pane fills the top; a bold rule then a compact footer (session
# header + diffstat) is pinned to the bottom, so the structured summary reads as
# a distinct block instead of blending into the terminal capture above it. The
# agent capture is tailed so its freshest line lands right against the rule.
# Sized to fit $FZF_PREVIEW_LINES. The diff comes from git, so the footer still
# renders for dead/revivable sessions — the case the old preview handled worst.
preview_pane() {
    local session="$1" wt_path="${2:-}"

    local dim=$'\033[2m' bold=$'\033[1m' rulec=$'\033[1;36m' reset=$'\033[0m'
    local avail="${FZF_PREVIEW_LINES:-40}"
    local cols="${FZF_PREVIEW_COLUMNS:-80}"
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    [[ "$avail" =~ ^[0-9]+$ ]] || avail=40

    # Best-effort metadata from the store; locals stay empty if it's not there.
    local status="" message="" repo="" branch="" pr="" agent="" opencode_config=""
    local pr_state="" pr_state_checked_at=""
    load_session "$session" 2>/dev/null || true
    if [[ -z "$branch" && -n "$wt_path" ]]; then
        branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || echo detached)
    fi

    # Resolve the base the branch forked from, then diff the whole delta since
    # that fork point. `git diff <merge-base>` compares that commit to the WORK
    # TREE, so it covers committed *and* uncommitted changes together — commits
    # keep showing after `git commit`. The base is the branch's stored wtBase if
    # present (see create_worktree), else origin's default head.
    local base_label="" stat="" untracked=""
    if [[ -n "$wt_path" && -e "$wt_path/.git" ]]; then
        # Prefer the branch's stored base, else origin's default head. Verify the
        # ref still resolves: a rebase onto a different base, or deleting the base
        # branch, can leave the stored value dangling — fall back rather than let
        # merge-base fail into a HEAD-only (committed-changes-hidden) diff.
        local base_ref merge_base
        base_ref=$(git -C "$wt_path" config "branch.${branch}.wtBase" 2>/dev/null || true)
        if [[ -z "$base_ref" ]] || ! git -C "$wt_path" rev-parse --verify -q "${base_ref}^{commit}" >/dev/null 2>&1; then
            base_ref=$(git -C "$wt_path" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)
            base_ref=${base_ref#refs/remotes/}
            [[ -n "$base_ref" ]] || base_ref="origin/main"
        fi
        base_label=${base_ref#origin/}
        merge_base=$(git -C "$wt_path" merge-base HEAD "$base_ref" 2>/dev/null || echo HEAD)
        # Tracked delta since the fork point (committed + staged + unstaged)...
        stat=$(git -C "$wt_path" -c color.ui=always diff \
                   --stat="${cols},,12" "$merge_base" 2>/dev/null)
        # ...plus brand-new files git diff can't see (untracked, not yet added).
        untracked=$(git -C "$wt_path" ls-files --others --exclude-standard 2>/dev/null)
    fi

    # Show the cached PR state; if it's missing or stale, do one synchronous gh
    # lookup for the selected worktree (cheap — one call per selection) and write
    # it back so the ls badge and later previews are warm.
    local pr_disp="$pr_state"
    if [[ -n "$branch" && -n "$wt_path" && -e "$wt_path/.git" ]] \
       && { [[ -z "$pr_disp" ]] || is_pr_stale "$pr_state_checked_at"; }; then
        local fresh
        fresh=$(pr_state_lookup "$branch" "$wt_path")
        if [[ -n "$fresh" ]]; then
            pr_disp="$fresh"
            "$WT_STATE" set "$session" --pr-state "$fresh" >/dev/null 2>&1 || true
        fi
    fi

    # Footer: bold rule + session header + diffstat. Built into a buffer so we
    # can measure its height and give the agent capture whatever rows remain.
    local agent_lbl footer
    agent_lbl=$(agent_label "${agent:-$WT_DEFAULT_AGENT}")
    footer=$(
        local rule icon h
        printf -v rule '%*s' "$cols" ''
        printf '%s%s%s\n' "$rulec" "${rule// /━}" "$reset"

        icon=$(get_status_icon_ansi "${status:-unknown}")
        h="${icon} ${bold}${branch:-?}${reset}"
        [[ -n "$base_label" ]] && h+="${dim} vs ${base_label}${reset}"
        [[ -n "$pr" ]] && h+=" · PR#${pr}"
        case "$pr_disp" in
            merged|open|draft|closed) h+=" · $(pr_badge "$pr_disp") ${pr_disp}" ;;
        esac
        [[ -n "$status" ]] && h+=" · ${status}"
        h+="${dim} · ${agent_lbl}${reset}"
        printf '%s\n' "$h"

        if [[ -n "$wt_path" && -e "$wt_path/.git" ]]; then
            [[ -n "$stat" ]] && printf '%s\n' "$stat"
            if [[ -n "$untracked" ]]; then
                local green=$'\033[32m' n=0 f
                while IFS= read -r f; do
                    n=$((n+1)); (( n > 8 )) && continue
                    printf ' %s%s%s %s(new)%s\n' "$green" "$f" "$reset" "$dim" "$reset"
                done <<< "$untracked"
                (( n > 8 )) && printf ' %s… +%d more new%s\n' "$dim" $(( n - 8 )) "$reset"
            fi
            [[ -z "$stat" && -z "$untracked" ]] && printf '%s(no changes yet)%s\n' "$dim" "$reset"
        fi
        : # keep the subshell's exit status 0 — a trailing failed test would
          # make footer=$(...) non-zero and errexit would kill the preview
    )

    # Agent pane on top, tailed to the rows above the footer so the newest
    # output survives and lands right against the rule.
    local footer_lines budget cap
    footer_lines=$(printf '%s\n' "$footer" | wc -l)
    budget=$(( avail - footer_lines - 1 ))
    (( budget < 3 )) && budget=3

    cap=$(tmux capture-pane -p -e -t "$session:main.1" 2>/dev/null \
          || tmux capture-pane -p -e -t "$session:agent" 2>/dev/null || true)
    if [[ -n "$cap" ]]; then
        printf '%s\n' "$cap" | tail -n "$budget"
    else
        printf '%s(session not running — Enter to revive)%s\n' "$dim" "$reset"
    fi

    printf '%s\n' "$footer"
}

pick_worktree() {
    check_deps

    # Rows arrive most-recently-active first (recency ranking in list_worktrees).
    local selection rc=0
    selection=$(pick_list | fzf \
        "${WT_FZF_VIM_ARGS[@]}" \
        --delimiter=: \
        --with-nth=3 \
        --header="Select worktree (Enter=switch, Ctrl-D=delete)" \
        --preview="$WT_BIN_DIR/wt preview-pane {1} {2}" \
        --preview-window=right:60% \
        --bind="ctrl-d:execute(wt delete {1} --force)+reload($WT_BIN_DIR/wt pick-list)") || rc=$?
    if (( rc == 130 )); then echo "Cancelled." >&2; return 0; fi

    if [[ -n "$selection" ]]; then
        local session_name wt_path
        session_name=$(echo "$selection" | cut -d: -f1)
        wt_path=$(echo "$selection" | cut -d: -f2)
        if ! tmux has-session -t "$session_name" 2>/dev/null; then
            printf "Session '%s' is not running. Reviving...\n" "$session_name" >/dev/tty
            revive_worktree_session "$session_name" "$wt_path" || return 1
        fi
        switch_to "$session_name"
    fi
}

# Recency-ranked session switcher (bound to prefix+W via a tmux popup). Unlike
# pick_worktree it only lists sessions with a live tmux session — switching, not
# reviving — so it shares the exact recency order that choose-tree couldn't.
switch_picker() {
    check_deps

    local selection rc=0
    selection=$(pick_list \
        | while IFS=: read -r name path rest; do
              tmux has-session -t "$name" 2>/dev/null && printf '%s:%s:%s\n' "$name" "$path" "$rest"
          done \
        | fzf \
            "${WT_FZF_VIM_ARGS[@]}" \
            --delimiter=: \
            --with-nth=3 \
            --header="Switch session (recent first)" \
            --preview="$WT_BIN_DIR/wt preview-pane {1} {2}" \
            --preview-window=right:60%) || rc=$?
    if (( rc == 130 )); then echo "Cancelled." >&2; return 0; fi

    if [[ -n "$selection" ]]; then
        local session_name
        session_name=$(echo "$selection" | cut -d: -f1)
        switch_to "$session_name"
    fi
}

# -----------------------------------------------------------------------------
#  Sync tmux options from status files (for after tmux restart)
# -----------------------------------------------------------------------------
sync_tmux() {
    # Project every stored session (master included via is_master) onto its tmux
    # options. @tsv escapes tabs/newlines in fields so read stays aligned.
    local name status message repo branch wt_path pr agent opencode_config is_master icon
    while IFS=$'\t' read -r name status message repo branch wt_path pr agent opencode_config is_master; do
        tmux has-session -t "$name" 2>/dev/null || continue

        if [[ "$is_master" == "1" ]]; then
            tmux set-option -qt "$name" @wt-master  "1"
            tmux set-option -qt "$name" @wt-icon    "◆"
            tmux set-option -qt "$name" @wt-status  "${status:-idle}"
            tmux set-option -qt "$name" @wt-message "${message:-Orchestrator}"
            tmux set-option -qt "$name" @wt-agent   "${agent:-$WT_DEFAULT_AGENT}"
            tmux set-option -qt "$name" @wt-opencode-config "${opencode_config:-}"
        else
            icon=$(get_status_icon "${status:-unknown}")
            tmux set-option -qt "$name" @wt-status  "${status:-unknown}"
            tmux set-option -qt "$name" @wt-icon    "$icon"
            tmux set-option -qt "$name" @wt-message "${message:-}"
            tmux set-option -qt "$name" @wt-repo    "${repo:-}"
            tmux set-option -qt "$name" @wt-branch  "${branch:-}"
            tmux set-option -qt "$name" @wt-wt-path "${wt_path:-}"
            tmux set-option -qt "$name" @wt-pr      "${pr:-}"
            tmux set-option -qt "$name" @wt-agent   "${agent:-$WT_DEFAULT_AGENT}"
            tmux set-option -qt "$name" @wt-master  "0"
            tmux set-option -qt "$name" @wt-opencode-config "${opencode_config:-}"
        fi
        if [[ -n "${opencode_config:-}" ]]; then
            tmux set-environment -t "$name" OPENCODE_CONFIG "$opencode_config"
        fi
    done < <("$WT_STATE" list | jq -r '.[] | [.name,.status,.message,.repo,.branch,.wt_path,.pr,.agent,.opencode_config,(if .is_master then "1" else "0" end)] | @tsv')

    tmux refresh-client -S 2>/dev/null || true
}

# -----------------------------------------------------------------------------
#  Master Session
# -----------------------------------------------------------------------------
master() {
    local agent="${1:-$WT_DEFAULT_AGENT}"
    local force="${2:-false}"
    local session="wt-master"

    if tmux has-session -t "$session" 2>/dev/null; then
        if [[ "$force" == "true" ]]; then
            echo "Replacing existing master session..."
            # Switch away first so killing doesn't disconnect the client
            local other
            other=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -v "^${session}$" | head -1 || true)
            if [[ -n "$other" && -n "${TMUX:-}" ]]; then
                tmux switch-client -t "$other" 2>/dev/null || true
            fi
            tmux kill-session -t "$session"
        else
            echo "Master session already exists, switching..."
            switch_to "$session"
            return
        fi
    fi

    local bin
    bin=$(agent_binary "$agent")
    local label
    label=$(agent_label "$agent")

    echo "Creating master session ($label)..."

    # Set up master working directory with MCP profile
    local master_dir="$WT_BASE_DIR/.master"
    mkdir -p "$master_dir"
    local opencode_config=""
    opencode_config=$(configure_mcp_profile "$master_dir" "$agent" "master" "$session" || true)

    # Apply default-allowed tools for Claude master sessions
    if [[ "$agent" == "claude" ]]; then
        apply_allowed_tools "$master_dir"
    fi

    tmux new-session -d -s "$session" -c "$master_dir" -n agent
    tmux new-window -t "$session" -n shell -c "$HOME"
    tmux select-window -t "$session:agent"

    tmux set-option -qt "$session" @wt-opencode-config "$opencode_config"
    if [[ -n "$opencode_config" ]]; then
        tmux set-environment -t "$session" OPENCODE_CONFIG "$opencode_config"
    fi

    # Start agent without --ide (master has no nvim)
    if [[ "$agent" == "opencode" && -n "$opencode_config" ]]; then
        tmux send-keys -t "$session:agent" "OPENCODE_CONFIG=$(shell_quote "$opencode_config") $bin" Enter
    else
        tmux send-keys -t "$session:agent" "$bin" Enter
    fi

    # Set tmux metadata
    tmux set-option -qt "$session" @wt-master  "1"
    tmux set-option -qt "$session" @wt-icon    "◆"
    tmux set-option -qt "$session" @wt-status  "idle"
    tmux set-option -qt "$session" @wt-message "Orchestrator"
    tmux set-option -qt "$session" @wt-repo    ""
    tmux set-option -qt "$session" @wt-branch  ""
    tmux set-option -qt "$session" @wt-pr      ""
    tmux set-option -qt "$session" @wt-agent   "$agent"

    # Persist master as a row (is_master=1 keeps it out of status-bar counts)
    "$WT_STATE" set "$session" --is-master 1 --status idle --message Orchestrator \
        --agent "$agent" --opencode-config "$opencode_config" >/dev/null

    switch_to "$session"
}

# -----------------------------------------------------------------------------
#  PR Lookup
# -----------------------------------------------------------------------------
pr_lookup() {
    local pr_number="${1:-}"

    if ! command -v gh &>/dev/null; then
        echo "gh (GitHub CLI) is required for PR lookup"
        exit 1
    fi

    if [[ -z "$pr_number" ]]; then
        echo "Usage: wt pr <number>"
        return 1
    fi

    # Get branch name from PR
    local target_branch
    target_branch=$(gh pr view "$pr_number" --json headRefName -q .headRefName 2>/dev/null)

    if [[ -z "$target_branch" ]]; then
        echo "Could not find PR #$pr_number"
        return 1
    fi

    echo "PR #$pr_number → branch: $target_branch"

    # Search tmux sessions for matching branch
    local session
    for session in $(tmux list-sessions -F "#{session_name}" 2>/dev/null); do
        local session_branch
        session_branch=$(tmux show-option -qv -t "$session" @wt-branch 2>/dev/null || echo "")
        if [[ "$session_branch" == "$target_branch" ]]; then
            echo "Found session: $session"
            # Store PR link (tmux for live display, store for persistence)
            tmux set-option -qt "$session" @wt-pr "$pr_number"
            "$WT_STATE" set "$session" --pr "$pr_number" >/dev/null 2>&1 || true
            switch_to "$session"
            return
        fi
    done

    echo "No active worktree session for branch '$target_branch'"
    echo ""
    read -p "Create worktree for this branch? [y/N] " confirm </dev/tty
    if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
        interactive_new "" "$target_branch"
    fi
}

pr_pick() {
    check_deps

    if ! command -v gh &>/dev/null; then
        echo "gh (GitHub CLI) is required for PR lookup"
        exit 1
    fi

    # List open PRs via gh, let user pick with fzf
    local selection rc=0
    selection=$(gh pr list --json number,title,headRefName \
        --template '{{range .}}{{.number}}	{{.title}}	{{.headRefName}}{{"\n"}}{{end}}' 2>/dev/null \
        | fzf \
            "${WT_FZF_VIM_ARGS[@]}" \
            --header="Select PR to open" \
            --delimiter='\t' \
            --with-nth=1,2 \
            --preview='echo "PR #{1} → branch: {3}"') || rc=$?
    if (( rc == 130 )); then echo "Cancelled." >&2; return 0; fi

    if [[ -n "$selection" ]]; then
        local pr_num
        pr_num=$(echo "$selection" | cut -f1)
        pr_lookup "$pr_num"
    fi
}

# -----------------------------------------------------------------------------
#  Delete Picker (for tmux menu popup)
# -----------------------------------------------------------------------------
delete_pick() {
    check_deps

    local selection rc=0
    selection=$(list_worktrees full | fzf \
        "${WT_FZF_VIM_ARGS[@]}" \
        --ansi \
        --header="Select worktree to delete") || rc=$?
    if (( rc == 130 )); then echo "Cancelled." >&2; return 0; fi

    if [[ -n "$selection" ]]; then
        local repo_name branch_name
        repo_name=$(echo "$selection" | awk '{print $2}')
        branch_name=$(echo "$selection" | awk '{print $3}')
        local session_name="${repo_name}-${branch_name//\//-}"
        delete_worktree "$session_name"
    fi
}

# -----------------------------------------------------------------------------
#  Agent Integration
# -----------------------------------------------------------------------------
start_agent() {
    local session_name="$1"
    local task="$2"

    if ! tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Session '$session_name' does not exist"
        return 1
    fi

    # Send agent launch command
    if [[ -n "$task" ]]; then
        tmux send-keys -t "$session_name:main.1" "$WT_BIN_DIR/wt-agent-launch \"$task\"" Enter
    else
        tmux send-keys -t "$session_name:main.1" "$WT_BIN_DIR/wt-agent-launch" Enter
    fi
    set_status "$session_name" "working" "${task:-Interactive session}"
}

# -----------------------------------------------------------------------------
#  Main CLI
# -----------------------------------------------------------------------------
usage() {
    cat <<EOF
wt - Worktree Manager for Multi-Agent CLI Workflow

Usage: wt <command> [options]

Session Management:
  new [repo] [branch]     Create new worktree in the background (interactive if no args)
  new ... --switch        Create and switch to it (default stays in current session)
  pick, p                 Interactive session picker (fzf, diff + agent preview)
  switch, s <session>     Switch to a session
  list, ls                List all sessions with status
  delete, rm <session>    Delete a session and its worktree
  delete-pick             Interactive delete picker (fzf)

Master Session:
  master                  Create/attach master orchestrator session
  master --force          Replace existing master session
  master --agent <name>   Master with specific agent

PR Integration:
  pr <number>             Find session by PR number and switch to it
  pr-pick                 Interactive PR picker (fzf + gh)
  (list/pick show a PR badge per worktree: ⬤ merged, ◆ open, ◇ draft,
   ⊘ closed. Resolved via gh by branch and cached; needs gh installed.)

Agent Control:
  agent <session> [task]  Start agent on a task in a session
  claude <session> [task] Alias for 'agent'

Status:
  status <session>                        Get session status
  set-status <session> <status> [msg]     Set session status
  sync-tmux                               Restore tmux options from status files

Options for 'new':
  --agent <name>        Agent: claude, codex, gemini, opencode (default: \$WT_DEFAULT_AGENT)
  --base <branch>       Base a new branch off <branch> (default: repo's default branch)
  --start-agent         Start agent immediately after creating session
  --task <task>         Task description for agent
  --force               Skip confirmation prompts

Tmux Keybindings:
  prefix + w    Action menu (new, switch, delete, PR, master)
  prefix + W    Session switcher (fzf popup, most-recently-active first)
  prefix + M    Jump to master session

MCP Profiles:
  Sessions get MCP servers from ~/.config/wt/mcp-profiles/default.json
  Master gets MCP servers from ~/.config/wt/mcp-profiles/master.json
  Existing .mcp.json in a repo is preserved (not overwritten)
  opencode sessions get generated OPENCODE_CONFIG files under ~/.config/wt/opencode-mcp/

Tool Permissions (Claude only):
  Configure default-allowed tools in ~/.config/wt/claude-allowed-tools.json
  Format: JSON array of tool rules, e.g. ["Read", "Bash(npm run *)"]
  Applied to .claude/settings.local.json in each new worktree/master session

Examples:
  wt new                               Interactive: pick repo, branch, agent
  wt new ~/code feature-x              Create feature-x worktree
  wt new ~/code feature-x --agent codex  Use Codex instead of Claude
  wt pick                              Switch sessions (preview shows diff + agent)
  wt master                            Create/attach master session
  wt master --force                    Replace master session
  wt pr 42                             Find session for PR #42
  wt ls                                List all sessions

Environment:
  WT_BASE_DIR        Base directory for worktrees (default: ~/worktrees)
  WT_STATUS_DIR      Status file directory (default: ~/.local/state/wt)
  WT_DEFAULT_AGENT   Default agent CLI (default: opencode)
  WT_REPO_DIRS       Colon-separated dirs the repo picker scans; replaces the
                     built-in defaults (~/gt:~/code:~/projects:~/src:~/dev:
                     ~/work:~/workspace:~/repos). Each dir is listed if it is
                     itself a repo, and its immediate children are scanned.
  WT_DIFF_TOOL       Live diff plugin: unified | diffview (default: unified)
  WT_PR_TTL          Seconds a cached PR badge stays fresh (default: 900)
EOF
}

main() {
    local cmd="${1:-default}"
    shift || true

    log "cmd=$cmd args=$*"

    case "$cmd" in
        default)
            if [[ -n "${TMUX:-}" ]]; then
                # Inside tmux: show the action menu
                tmux display-menu -T " Worktrees " -x C -y C \
                    "New worktree"       n "display-popup -E -w 80% -h 80% '$HOME/bin/wt new --switch'" \
                    "New (background)"   N "display-popup -E -w 80% -h 80% '$HOME/bin/wt new'" \
                    "Switch (pick)"      s "display-popup -E -w 100% -h 100% '$HOME/bin/wt pick'" \
                    "Delete..."          d "display-popup -E -w 60% -h 40% '$HOME/bin/wt delete-pick'" \
                    "" \
                    "PR lookup..."       p "display-popup -E -w 60% -h 40% '$HOME/bin/wt pr-pick'" \
                    "" \
                    "Master session"     m "switch-client -t wt-master" \
                    "New master..."      M "display-popup -E -w 70% -h 50% '$HOME/bin/wt master --force'" \
                    "" \
                    "Sync status"        r "run-shell '$HOME/bin/wt sync-tmux'" \
                    "" \
                    "Quit (detach)"      q "detach-client"
            else
                # Outside tmux: attach to existing or start new
                if tmux list-sessions &>/dev/null; then
                    exec tmux attach
                else
                    exec tmux
                fi
            fi
            ;;
        list|ls)
            list_worktrees "${1:-full}"
            ;;
        new)
            local repo="${1:-}"
            local branch="${2:-}"
            local start_agent=false
            local task=""
            local agent="$WT_DEFAULT_AGENT"
            local base=""             # empty → detect the repo's default branch
            local switch_after=false  # background by default; --switch to jump

            # Skip repo/branch args if they look like flags
            if [[ "$repo" == --* ]]; then
                repo=""
                branch=""
            elif [[ "$branch" == --* ]]; then
                branch=""
                shift 1 || true
            else
                shift 2 || true
            fi

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --start-agent|--start-claude) start_agent=true; shift ;;
                    --task) task="$2"; shift 2 ;;
                    --agent) agent="$2"; shift 2 ;;
                    --base) base="$2"; shift 2 ;;
                    --switch) switch_after=true; shift ;;
                    *) shift ;;
                esac
            done

            # Use interactive mode if repo or branch not provided
            if [[ -z "$repo" || -z "$branch" ]]; then
                interactive_new "$repo" "$branch" "$switch_after"
            else
                # Default the base to the repo's detected default branch so a new
                # branch created here matches the interactive flow's intent rather
                # than silently forking off whatever HEAD happens to be. (Ignored
                # by create_worktree when the branch already exists.)
                [[ -z "$base" ]] && base=$(detect_default_branch "$repo")
                create_worktree "$repo" "$branch" "$start_agent" "$task" "$base" "$agent" "$switch_after"
            fi
            ;;
        pick|p)
            pick_worktree
            ;;
        pick-list)
            pick_list
            ;;
        preview-pane)
            preview_pane "${1:-}" "${2:-}"
            ;;
        switch|s)
            if [[ -n "${1:-}" ]]; then
                switch_to "$1"
            else
                switch_picker
            fi
            ;;
        delete|rm)
            local force=false
            [[ "${2:-}" == "--force" ]] && force=true
            delete_worktree "${1:-}" "$force"
            ;;
        delete-pick)
            delete_pick
            ;;
        master)
            local agent="$WT_DEFAULT_AGENT"
            local force=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --agent) agent="$2"; shift 2 ;;
                    --force) force=true; shift ;;
                    *) shift ;;
                esac
            done
            master "$agent" "$force"
            ;;
        pr)
            pr_lookup "${1:-}"
            ;;
        pr-pick)
            pr_pick
            ;;
        sync-tmux)
            sync_tmux
            ;;
        agent|claude)
            start_agent "${1:-}" "${2:-}"
            ;;
        status)
            get_status "${1:-}"
            ;;
        set-status)
            set_status "${1:-}" "${2:-}" "${3:-}"
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            echo "Unknown command: $cmd"
            usage
            exit 1
            ;;
    esac
}

main "$@"
