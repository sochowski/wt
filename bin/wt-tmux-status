#!/usr/bin/env bash
# =============================================================================
#  wt-tmux-status - Tmux status bar segment showing worktree status
#  Add to tmux status-right: #($HOME/bin/wt-tmux-status)
#  Cross-platform: Arch Linux / macOS
# =============================================================================

WT_STATUS_DIR="${WT_STATUS_DIR:-$HOME/.local/state/wt}"

# wt-state binary: sibling of this script (repo or ~/bin install), else PATH.
WT_TMUX_STATUS_DIR="$(dirname "$(readlink -f "$0")")"
WT_STATE="${WT_STATE:-$WT_TMUX_STATUS_DIR/wt-state}"
[[ -x "$WT_STATE" ]] || WT_STATE="wt-state"

# Count statuses in one query (master excluded by wt-state). `counts` prints
# `working=N` lines, which we eval directly.
working=0
idle=0
input=0
error=0
eval "$("$WT_STATE" counts 2>/dev/null || true)"

# Build output string (using terminal palette colours)
output=""

# Master session indicator
master_status=$(tmux show-option -qv -t wt-master @wt-status 2>/dev/null || echo "")
if [[ -n "$master_status" ]]; then
    if [[ "$master_status" == "working" ]]; then
        output+="#[fg=colour5]◆#[fg=default] "
    else
        output+="#[fg=colour8]◆#[fg=default] "
    fi
fi

# Only show non-zero counts
[[ $working -gt 0 ]] && output+="#[fg=colour8]●${working}#[fg=default] "
[[ $idle -gt 0 ]]    && output+="#[fg=colour4]○${idle}#[fg=default] "
[[ $input -gt 0 ]]   && output+="#[fg=colour3]⊘${input}#[fg=default] "
[[ $error -gt 0 ]]   && output+="#[fg=colour1]✗${error}#[fg=default] "

# Trim trailing space
output="${output% }"

# If nothing tracked, show empty or placeholder
if [[ -z "$output" ]]; then
    echo ""
else
    echo "$output"
fi
