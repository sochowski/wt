#!/usr/bin/env bash
# wt-bind-menu — generate tmux menu + direct keybindings from wt-menu.conf
#
# Reads menu items from wt-menu.conf and generates:
#   1. A display-menu bound to prefix+w
#   2. Individual prefix+<key> bindings for each item
#
# Called automatically via run-shell in tmux-wt.conf on tmux startup.
# Run manually after editing wt-menu.conf to apply changes immediately.
set -euo pipefail

WN_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wt"
MENU_CONF="${WN_DIR}/wt-menu.conf"
OUT="${WN_DIR}/wt-menu-bindings.conf"

if [[ ! -f "$MENU_CONF" ]]; then
    echo "wt-bind-menu: ${MENU_CONF} not found" >&2
    exit 1
fi

menu_args=""
binds=""

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line// /}" ]] && continue

    if [[ "$line" == "---" ]]; then
        menu_args+=' ""'
        continue
    fi

    IFS=$'\t' read -r key label cmd <<< "$line"
    [[ -z "$key" || -z "$cmd" ]] && continue

    menu_args+=" \"${label}\" ${key} \"${cmd}\""
    binds+="bind ${key} ${cmd}"$'\n'
done < "$MENU_CONF"

{
    echo "# Auto-generated by wt-bind-menu — edit wt-menu.conf, not this file"
    echo ""
    printf 'bind w display-menu -T " Worktrees " -x C -y C%s "" "Quit" q ""\n' "$menu_args"
    echo ""
    echo "# Direct keybindings (prefix+<key>)"
    printf '%s' "$binds"
} > "$OUT"

tmux source-file "$OUT" 2>/dev/null || true
