#!/usr/bin/env bash
# =============================================================================
#  claude-ide - Smart Claude launcher that auto-connects to the right Neovim
#  Matches IDE based on current working directory
# =============================================================================

set -euo pipefail

CLAUDE_IDE_DIR="${HOME}/.claude/ide"
CLAUDE_IDE_HIDDEN="${HOME}/.claude/ide/.hidden"
CWD="$(pwd)"

# Find the lock file whose workspaceFolders best matches our cwd (longest match wins)
find_matching_ide() {
    if [[ ! -d "$CLAUDE_IDE_DIR" ]]; then
        return 1
    fi

    local best_match=""
    local best_match_len=0

    for lock_file in "$CLAUDE_IDE_DIR"/*.lock; do
        [[ -f "$lock_file" ]] || continue

        # Extract workspaceFolders from JSON
        local workspace
        workspace=$(grep -o '"workspaceFolders":\[[^]]*\]' "$lock_file" 2>/dev/null | \
                    grep -o '"/[^"]*"' | tr -d '"' | head -1)

        if [[ -n "$workspace" ]]; then
            # Check if cwd starts with workspace (is inside or equal to it)
            if [[ "$CWD" == "$workspace"* ]]; then
                # Verify the process is still running
                local pid
                pid=$(grep -o '"pid":[0-9]*' "$lock_file" | grep -o '[0-9]*')
                if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
                    # Keep the longest (most specific) match
                    local workspace_len=${#workspace}
                    if [[ $workspace_len -gt $best_match_len ]]; then
                        best_match="$lock_file"
                        best_match_len=$workspace_len
                    fi
                fi
            fi
        fi
    done

    if [[ -n "$best_match" ]]; then
        echo "$best_match"
        return 0
    fi
    return 1
}

# Clean up stale lock files (processes no longer running)
cleanup_stale_locks() {
    if [[ ! -d "$CLAUDE_IDE_DIR" ]]; then
        return
    fi

    for lock_file in "$CLAUDE_IDE_DIR"/*.lock; do
        [[ -f "$lock_file" ]] || continue

        local pid
        pid=$(grep -o '"pid":[0-9]*' "$lock_file" | grep -o '[0-9]*')

        if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$lock_file"
        fi
    done
}

# Hide non-matching lock files temporarily
hide_other_locks() {
    local keep_lock="$1"
    mkdir -p "$CLAUDE_IDE_HIDDEN"

    for lock_file in "$CLAUDE_IDE_DIR"/*.lock; do
        [[ -f "$lock_file" ]] || continue
        if [[ "$lock_file" != "$keep_lock" ]]; then
            mv "$lock_file" "$CLAUDE_IDE_HIDDEN/"
        fi
    done
}

# Restore hidden lock files
restore_hidden_locks() {
    if [[ -d "$CLAUDE_IDE_HIDDEN" ]]; then
        for lock_file in "$CLAUDE_IDE_HIDDEN"/*.lock; do
            [[ -f "$lock_file" ]] || continue
            mv "$lock_file" "$CLAUDE_IDE_DIR/"
        done
        rmdir "$CLAUDE_IDE_HIDDEN" 2>/dev/null || true
    fi
}

# Cleanup on exit
cleanup() {
    restore_hidden_locks
}

main() {
    # Clean up stale locks first
    cleanup_stale_locks

    # Restore any previously hidden locks (in case of crash)
    restore_hidden_locks

    # Find matching IDE for current directory
    local matching_lock=""
    matching_lock=$(find_matching_ide || true)

    # Count lock files
    local lock_count=0
    if [[ -d "$CLAUDE_IDE_DIR" ]]; then
        lock_count=$(find "$CLAUDE_IDE_DIR" -maxdepth 1 -name "*.lock" -type f 2>/dev/null | wc -l)
    fi

    if [[ $lock_count -eq 0 ]]; then
        # No IDEs, just run claude normally
        exec claude "$@"
    elif [[ $lock_count -eq 1 ]]; then
        # Exactly one IDE, auto-connect
        exec claude --ide "$@"
    elif [[ -n "$matching_lock" ]]; then
        # Multiple IDEs but we found a match - hide others temporarily
        trap cleanup EXIT INT TERM
        hide_other_locks "$matching_lock"
        claude --ide "$@"
        local exit_code=$?
        restore_hidden_locks
        trap - EXIT INT TERM
        exit $exit_code
    else
        # Multiple IDEs, none matching - let user choose
        exec claude --ide "$@"
    fi
}

main "$@"
