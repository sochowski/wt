#!/usr/bin/env bash
# =============================================================================
#  wt-agent-launch - Multi-agent launcher for worktree sessions
#  Reads @wt-agent from the current tmux session, asks wt-state for a launch
#  plan (binary + args + env), then execs it. All per-agent quirks (Claude's
#  Neovim IDE locks, opencode's config resolution) live in the wt-state agent
#  registry — this script just gathers tmux context and runs the plan.
# =============================================================================

set -euo pipefail

WT_STATUS_DIR="${WT_STATUS_DIR:-$HOME/.local/state/wt}"
WT_CONFIG_DIR="${WT_CONFIG_DIR:-$HOME/.config/wt}"

# wt-state binary: sibling of this script (repo or ~/bin install), else PATH.
WT_LAUNCH_DIR="$(dirname "$(readlink -f "$0")")"
WT_STATE="${WT_STATE:-$WT_LAUNCH_DIR/wt-state}"
[[ -x "$WT_STATE" ]] || WT_STATE="wt-state"

# --resume (passed by `wt` revive): ask the plan to resume the prior
# conversation instead of starting cold. The captured native session id (if
# any) is read from the store below and handed to the plan.
RESUME=0
if [[ "${1:-}" == "--resume" ]]; then
    RESUME=1
    shift
fi

# Determine which agent to launch and gather tmux-side context for the plan.
AGENT="${WT_DEFAULT_AGENT:-opencode}"
local_session=""
opencode_candidate=""
resume_session_id=""
if [[ -n "${TMUX:-}" ]]; then
    local_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    if [[ -n "$local_session" ]]; then
        # Hooks inherit this stable identity through the agent process. Unlike
        # cwd-derived repo/branch names, it remains correct when the agent
        # visits another checkout in a future workspace session.
        export WT_SESSION="$local_session"
        tmux_agent=$(tmux show-option -qv -t "$local_session" @wt-agent 2>/dev/null || true)
        opencode_candidate=$(tmux show-option -qv -t "$local_session" @wt-opencode-config 2>/dev/null || true)
        if json=$("$WT_STATE" get "$local_session" --json 2>/dev/null); then
            [[ -z "$tmux_agent" ]] && tmux_agent=$(jq -r '.agent // ""' <<<"$json")
            [[ -z "$opencode_candidate" ]] && opencode_candidate=$(jq -r '.opencode_config // ""' <<<"$json")
            resume_session_id=$(jq -r '.agent_session_id // ""' <<<"$json")
        fi
        [[ -n "$tmux_agent" ]] && AGENT="$tmux_agent"
    fi
fi

# Ask the registry how to launch. The plan may perform side effects (e.g.
# reconciling Claude IDE locks) and emits shell we eval: WT_LAUNCH_BINARY,
# WT_LAUNCH_ARGS (array), and any `export`ed env (e.g. OPENCODE_CONFIG).
plan_flags=(--sh --session "$local_session"
            --opencode-config "$opencode_candidate"
            --config-dir "$WT_CONFIG_DIR")
if [[ "$RESUME" == "1" ]]; then
    plan_flags+=(--resume --resume-session-id "$resume_session_id")
fi

# Resolve a launch plan into WT_LAUNCH_BINARY / WT_LAUNCH_ARGS (empty plan →
# exec the agent name directly, mirroring the old bash fallback).
resolve_plan() {
    WT_LAUNCH_BINARY=""
    WT_LAUNCH_ARGS=()
    local plan
    if plan=$("$WT_STATE" agent "$AGENT" launch-plan "$@" 2>/dev/null); then
        eval "$plan"
    fi
    [[ -n "$WT_LAUNCH_BINARY" ]] || WT_LAUNCH_BINARY="$AGENT"
}

resolve_plan "${plan_flags[@]}"

if [[ "$RESUME" != "1" ]]; then
    exec "$WT_LAUNCH_BINARY" "${WT_LAUNCH_ARGS[@]}" "$@"
fi

# Resume mode: a resume invocation can fail fast — a stale/foreign session id,
# or Claude's session lookup itself erroring on the first run after boot
# ("Invalid session ID: unknown error"). Don't leave the pane dead on it: if an
# attempt exits nonzero within seconds (an immediate rejection, not a real
# session the user later closed), retry one rung down the ladder:
#   exact-id resume → [claude: once-per-boot warm-up, retry] → cwd-latest → fresh.
attempted=" "
run_attempt() {
    local allow_repeat=""
    [[ "${1:-}" == "--again" ]] && { allow_repeat=1; shift; }
    local key="${WT_LAUNCH_BINARY} ${WT_LAUNCH_ARGS[*]-}"
    # Skip attempts that resolve to a command line we already tried (e.g. no
    # captured id, so rung 1 and rung 2 are the same --continue invocation) —
    # unless this is an explicit post-warm-up retry.
    if [[ -z "$allow_repeat" ]]; then
        [[ "$attempted" == *" ${key} "* ]] && return 1
    fi
    attempted+="${key} "

    local start=$SECONDS rc=0
    "$WT_LAUNCH_BINARY" "${WT_LAUNCH_ARGS[@]}" "$@" || rc=$?
    (( rc == 0 )) && exit 0
    # Ran for a while before failing: a real session, not a rejected resume.
    (( SECONDS - start >= 10 )) && exit "$rc"
    # Breadcrumb with the full agent resolution, so a wrong-agent launch (e.g.
    # opencode handed a claude id) is diagnosable from the pane text alone.
    echo "wt-agent-launch: '${key}' exited ${rc} immediately" \
         "(agent=${AGENT} @wt-agent='${tmux_agent:-}' session='${local_session}');" \
         "trying next resume fallback..." >&2
    return 1
}

# Rung 1: the plan already resolved above (exact-id when captured + on disk).
run_attempt "$@" || true

# Claude's session lookup can fail globally after a reboot until the binary
# has completed one run (upstream bug: `claude --resume <valid-id>` →
# "Invalid session ID: unknown error", cleared for ALL worktrees by any single
# run). If the first attempt was rejected, warm claude up once per boot with a
# minimal headless call and retry the same plan. The warm-up runs from $HOME —
# NEVER the worktree, since a -p run writes a transcript into its cwd's
# project dir and would poison the --continue rung below.
if [[ "$RESUME" == "1" && "$AGENT" == "claude" ]]; then
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
    warmup_stamp="${XDG_RUNTIME_DIR:-/tmp}/wt-claude-warmup-$(id -u)"
    if [[ "$(cat "$warmup_stamp" 2>/dev/null || true)" != "$boot_id" ]]; then
        echo "wt-agent-launch: warming up claude (first resume this boot)..." >&2
        ( cd "$HOME" && claude -p --model haiku "ok" >/dev/null 2>&1 ) || true
        echo "$boot_id" > "$warmup_stamp" 2>/dev/null || true
        run_attempt --again "$@" || true
    fi
fi

# Rung 2: same plan minus the captured id → the agent's cwd-latest resume.
resolve_plan --sh --session "$local_session" \
    --opencode-config "$opencode_candidate" --config-dir "$WT_CONFIG_DIR" \
    --resume --resume-session-id ""
run_attempt "$@" || true

# Rung 3: fresh launch, no resume at all.
resolve_plan --sh --session "$local_session" \
    --opencode-config "$opencode_candidate" --config-dir "$WT_CONFIG_DIR"
exec "$WT_LAUNCH_BINARY" "${WT_LAUNCH_ARGS[@]}" "$@"
