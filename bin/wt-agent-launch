#!/usr/bin/env bash
# =============================================================================
#  wt-agent-launch - Multi-agent launcher for worktree sessions
#  Reads @wt-agent from current tmux session to pick the right CLI
#  For Claude: auto-connects to the right Neovim via IDE lock files
#  For Codex/Gemini/opencode: launches the binary directly
# =============================================================================

set -euo pipefail

# Determine which agent to launch
AGENT="${WT_DEFAULT_AGENT:-claude}"
if [[ -n "${TMUX:-}" ]]; then
    local_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    if [[ -n "$local_session" ]]; then
        tmux_agent=$(tmux show-option -qv -t "$local_session" @wt-agent 2>/dev/null || true)
        if [[ -n "$tmux_agent" ]]; then
            AGENT="$tmux_agent"
        fi
    fi
fi

if [[ "$AGENT" == "opencode" && -z "${OPENCODE_CONFIG:-}" && -n "${TMUX:-}" ]]; then
    local_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
    if [[ -n "$local_session" ]]; then
        opencode_config=$(tmux show-option -qv -t "$local_session" @wt-opencode-config 2>/dev/null || true)
        if [[ -n "$opencode_config" ]]; then
            export OPENCODE_CONFIG="$opencode_config"
        fi
    fi
fi

case "$AGENT" in
    claude)
        # Clean up stale IDE lock files (dead neovim processes)
        CLAUDE_IDE_DIR="${HOME}/.claude/ide"
        if [[ -d "$CLAUDE_IDE_DIR" ]]; then
            for lock_file in "$CLAUDE_IDE_DIR"/*.lock; do
                [[ -f "$lock_file" ]] || continue
                pid=$(grep -o '"pid":[0-9]*' "$lock_file" | grep -o '[0-9]*')
                if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
                    rm -f "$lock_file"
                fi
            done

            # Restore any locks orphaned by previous hide/restore mechanism
            if [[ -d "$CLAUDE_IDE_DIR/.hidden" ]]; then
                for lock_file in "$CLAUDE_IDE_DIR/.hidden"/*.lock; do
                    [[ -f "$lock_file" ]] || continue
                    mv "$lock_file" "$CLAUDE_IDE_DIR/"
                done
                rmdir "$CLAUDE_IDE_DIR/.hidden" 2>/dev/null || true
            fi
        fi

        # Let Claude auto-detect the right neovim via CWD matching
        lock_count=0
        if [[ -d "$CLAUDE_IDE_DIR" ]]; then
            lock_count=$(find "$CLAUDE_IDE_DIR" -maxdepth 1 -name "*.lock" -type f 2>/dev/null | wc -l)
        fi

        if [[ $lock_count -eq 0 ]]; then
            exec claude "$@"
        else
            exec claude --ide "$@"
        fi
        ;;

    codex)
        exec codex "$@"
        ;;

    gemini)
        exec gemini "$@"
        ;;

    opencode)
        exec opencode "$@"
        ;;

    *)
        # Unknown agent — try to exec it directly
        exec "$AGENT" "$@"
        ;;
esac
