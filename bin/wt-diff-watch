#!/usr/bin/env bash
# =============================================================================
#  wt-diff-watch — keep a wt session's diff view live.
#
#  Usage: wt-diff-watch <worktree-path> <target> [base-rev]
#
#  <target> selects the renderer to refresh:
#    *.port  -> wt-diff-view fzf browser: POST reload+refresh-preview to fzf's
#               HTTP listener (needs curl and <base-rev>).
#    *.sock  -> nvim diffview: poke require('wt_diff').refresh() over RPC.
#
#  Watches the worktree (ignoring .git), debounced, and refreshes on every
#  change. Backends: watchexec -> entr -> inotifywait. Exits when the target
#  disappears (view gone) or no backend is installed — in which case the view
#  still opens, it just won't auto-refresh.
# =============================================================================
set -euo pipefail

# --- one-shot refresh mode (re-invoked by the watcher backends) --------------
if [[ "${1:-}" == "--refresh" ]]; then
    target="${2:?target required}"
    case "$target" in
        *.port)
            [[ -f "$target" ]] || exit 0
            port=$(cat "$target" 2>/dev/null || true)
            [[ -n "$port" ]] || exit 0
            # fzf runs the reload command itself; WT_DV_WT/WT_DV_BASE are expanded
            # here (this process has them exported) into a literal command string.
            curl -s -XPOST "localhost:$port" \
                --data "reload(git -C $WT_DV_WT diff --name-status $WT_DV_BASE)+refresh-preview" \
                >/dev/null 2>&1 || true
            ;;
        *.sock)
            [[ -S "$target" ]] || exit 0
            nvim --server "$target" --remote-expr \
                'luaeval("pcall(function() require([[wt_diff]]).refresh() end)")' \
                >/dev/null 2>&1 || true
            ;;
    esac
    exit 0
fi

wt="${1:?worktree path required}"
target="${2:?target (.port or .sock) required}"
base="${3:-}"

case "$target" in
    *.port) command -v curl >/dev/null 2>&1 || exit 0 ;;
    *.sock) command -v nvim >/dev/null 2>&1 || exit 0 ;;
    *) exit 0 ;;
esac

# Wait up to ~30s for the view to publish its target.
for _ in $(seq 1 300); do
    [[ -e "$target" ]] && break
    sleep 0.1
done
[[ -e "$target" ]] || exit 0

# Exported so the --refresh reinvocation can build the fzf reload command.
export WT_DV_WT="$wt" WT_DV_BASE="$base"
self="$(readlink -f "$0")"

if command -v watchexec >/dev/null 2>&1; then
    exec watchexec --quiet --debounce 200ms --watch "$wt" --ignore '.git/**' -- \
        "$self" --refresh "$target"
elif command -v entr >/dev/null 2>&1; then
    while [[ -e "$target" ]]; do
        find "$wt" -type f -not -path '*/.git/*' 2>/dev/null \
            | entr -d "$self" --refresh "$target" || true
    done
elif command -v inotifywait >/dev/null 2>&1; then
    while [[ -e "$target" ]]; do
        if inotifywait -q -r -e modify,create,delete,move \
             --exclude '/\.git/' "$wt" >/dev/null 2>&1; then
            "$self" --refresh "$target"
        fi
    done
fi
