#!/usr/bin/env bash
# =============================================================================
#  wt-hook - Agent Hook Handler for Worktree Status Tracking
#  Called by agent hooks to update status automatically
# =============================================================================

set -euo pipefail

WT_STATUS_DIR="${WT_STATUS_DIR:-$HOME/.local/state/wt}"
WT_BASE_DIR="${WT_BASE_DIR:-$HOME/worktrees}"
WT_CONFIG_DIR="${WT_CONFIG_DIR:-$HOME/.config/wt}"
WT_DEFAULT_AGENT="${WT_DEFAULT_AGENT:-opencode}"

# wt-state binary: prefer a sibling of this script (repo or ~/bin install),
# fall back to PATH.
WT_HOOK_DIR="$(dirname "$(readlink -f "$0")")"
WT_STATE="${WT_STATE:-$WT_HOOK_DIR/wt-state}"
[[ -x "$WT_STATE" ]] || WT_STATE="wt-state"

# Ensure status directory exists
mkdir -p "$WT_STATUS_DIR"

# -----------------------------------------------------------------------------
#  Determine Session Name from CWD
# -----------------------------------------------------------------------------
get_session_name() {
    local cwd="${1:-$(pwd)}"

    # Check if we're in a worktree under WT_BASE_DIR
    if [[ "$cwd" == "$WT_BASE_DIR"/* ]]; then
        # Extract repo/branch from path like ~/worktrees/repo/branch
        local rel_path="${cwd#$WT_BASE_DIR/}"
        local repo_name="${rel_path%%/*}"
        local branch_name="${rel_path#*/}"
        branch_name="${branch_name%%/*}"  # Get first component after repo

        if [[ -n "$repo_name" && -n "$branch_name" ]]; then
            echo "${repo_name}-${branch_name}"
            return 0
        fi
    fi

    # Fallback: try to get from git branch
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        local repo_name
        repo_name=$(basename "$(git rev-parse --show-toplevel)")
        local branch
        branch=$(git branch --show-current 2>/dev/null || echo "detached")
        branch="${branch//\//-}"  # Sanitize slashes
        echo "${repo_name}-${branch}"
        return 0
    fi

    return 1
}

# -----------------------------------------------------------------------------
#  Status Functions
# -----------------------------------------------------------------------------
get_icon() {
    case "$1" in
        working) echo "●" ;;
        idle)    echo "○" ;;
        input)   echo "⊘" ;;
        error)   echo "✗" ;;
        *)       echo "?" ;;
    esac
}

derive_status_metadata() {
    local session_name="$1"
    local cwd="${2:-$(pwd)}"

    if tmux has-session -t "$session_name" 2>/dev/null; then
        [[ -z "$repo" ]] && repo=$(tmux show-option -qv -t "$session_name" @wt-repo 2>/dev/null || true)
        [[ -z "$branch" ]] && branch=$(tmux show-option -qv -t "$session_name" @wt-branch 2>/dev/null || true)
        [[ -z "$wt_path" ]] && wt_path=$(tmux show-option -qv -t "$session_name" @wt-wt-path 2>/dev/null || true)
        [[ -z "$agent" ]] && agent=$(tmux show-option -qv -t "$session_name" @wt-agent 2>/dev/null || true)
        [[ -z "$opencode_config" ]] && opencode_config=$(tmux show-option -qv -t "$session_name" @wt-opencode-config 2>/dev/null || true)
    fi

    if [[ -z "$wt_path" && -d "$cwd" ]] && git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        wt_path=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
    fi

    if [[ -n "$wt_path" && -d "$wt_path" ]]; then
        if [[ -z "$branch" ]]; then
            branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || true)
        fi
        if [[ -z "$repo" ]]; then
            if [[ "$wt_path" == "$WT_BASE_DIR"/* ]]; then
                local rel_path="${wt_path#$WT_BASE_DIR/}"
                repo="${rel_path%%/*}"
            else
                repo=$(basename "$(git -C "$wt_path" rev-parse --show-toplevel 2>/dev/null || echo "$wt_path")")
            fi
        fi
    fi

    if [[ -z "$repo" || -z "$branch" || -z "$wt_path" ]]; then
        local repo_dir candidate candidate_repo candidate_branch candidate_session
        for repo_dir in "$WT_BASE_DIR"/*; do
            [[ -d "$repo_dir" ]] || continue
            for candidate in "$repo_dir"/*; do
                [[ -d "$candidate" ]] || continue
                [[ -d "$candidate/.git" || -f "$candidate/.git" ]] || continue
                candidate_branch=$(git -C "$candidate" branch --show-current 2>/dev/null || true)
                [[ -n "$candidate_branch" ]] || candidate_branch="detached"
                candidate_repo=$(basename "$repo_dir")
                candidate_session="${candidate_repo}-${candidate_branch//\//-}"
                if [[ "$candidate_session" == "$session_name" ]]; then
                    [[ -z "$repo" ]] && repo="$candidate_repo"
                    [[ -z "$branch" ]] && branch="$candidate_branch"
                    [[ -z "$wt_path" ]] && wt_path="$candidate"
                    break 2
                fi
            done
        done
    fi

    [[ -z "$agent" ]] && agent="$WT_DEFAULT_AGENT"
    if [[ "$agent" == "opencode" && -z "$opencode_config" ]]; then
        local default_opencode_config="$WT_CONFIG_DIR/opencode-mcp/${session_name}.json"
        if [[ -f "$default_opencode_config" ]]; then
            opencode_config="$default_opencode_config"
        fi
    fi
}

load_session() {
    local name="$1" json
    json=$("$WT_STATE" get "$name" --json 2>/dev/null) || return 1
    eval "$(jq -r '{status,message,repo,branch,wt_path,pr,agent,opencode_config}
                   | to_entries[] | "\(.key)=\(.value|@sh)"' <<<"$json")"
}

save_session() {
    local name="$1"
    "$WT_STATE" set "$name" \
        --status "${status:-}" --message "${message:-}" \
        --repo "${repo:-}" --branch "${branch:-}" --wt-path "${wt_path:-}" \
        --pr "${pr:-}" --agent "${agent:-}" \
        --opencode-config "${opencode_config:-}" >/dev/null
}

set_status() {
    local session_name="$1"
    local status="$2"
    local message="${3:-}"

    local new_status="$status"
    local new_message="$message"

    # Preserve existing metadata fields if the session already has a row
    local pr="" repo="" branch="" wt_path="" agent="" opencode_config=""
    load_session "$session_name" || true
    status="$new_status"
    message="$new_message"
    derive_status_metadata "$session_name" "$(pwd)"

    # Persist to the store
    save_session "$session_name"

    # Write tmux user options for live display
    if tmux has-session -t "$session_name" 2>/dev/null; then
        local icon
        icon=$(get_icon "$status")
        tmux set-option -qt "$session_name" @wt-status  "$status"
        tmux set-option -qt "$session_name" @wt-icon    "$icon"
        tmux set-option -qt "$session_name" @wt-message "$message"
        tmux set-option -qt "$session_name" @wt-repo    "$repo"
        tmux set-option -qt "$session_name" @wt-branch  "$branch"
        tmux set-option -qt "$session_name" @wt-wt-path "$wt_path"
        tmux set-option -qt "$session_name" @wt-agent   "$agent"
        tmux set-option -qt "$session_name" @wt-opencode-config "$opencode_config"
        if [[ -n "$opencode_config" ]]; then
            tmux set-environment -t "$session_name" OPENCODE_CONFIG "$opencode_config"
        fi
        # Force immediate status bar redraw
        tmux refresh-client -S 2>/dev/null || true
    fi
}

# -----------------------------------------------------------------------------
#  Notification (Cross-Platform)
# -----------------------------------------------------------------------------
notify() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"
    local context="${4:-}"        # worktree/branch, prefixed onto the summary

    # App stays "wt"; the worktree goes in the summary so picker rows read
    # "wt: <branch> · <title> — <message>" and stay scannable by worktree.
    local summary="$title"
    [[ -n "$context" ]] && summary="$context · $title"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        osascript -e "display notification \"$message\" with title \"$summary\"" 2>/dev/null || true
    else
        notify-send -a wt -u "$urgency" "$summary" "$message" 2>/dev/null || true
    fi
}

# -----------------------------------------------------------------------------
#  Agent / Branch Labels
# -----------------------------------------------------------------------------
get_branch() {
    local session_name="${1:-}"
    local branch=""
    [[ -n "$session_name" ]] && branch=$(tmux show-option -qv -t "$session_name" @wt-branch 2>/dev/null || true)
    echo "${branch:-$session_name}"
}

# The agent's name is its display string. Read it from the store, falling back
# to the default agent.
get_agent_label() {
    local session_name="${1:-}"
    local agent=""
    if [[ -n "$session_name" ]]; then
        agent=$("$WT_STATE" get "$session_name" --field agent 2>/dev/null || true)
    fi
    echo "${agent:-$WT_DEFAULT_AGENT}"
}

# -----------------------------------------------------------------------------
#  Hook Handlers
# -----------------------------------------------------------------------------
# Read JSON from stdin (agent passes context this way)
read_stdin() {
    local input=""
    if read -t 0.1 -r line; then
        input="$line"
        while read -t 0.1 -r line; do
            input+="$line"
        done
    fi
    echo "$input"
}

handle_session_start() {
    local session_name
    if session_name=$(get_session_name); then
        local label
        label=$(get_agent_label "$session_name")
        set_status "$session_name" "working" "$label started"
    fi
}

handle_stop() {
    local session_name
    if session_name=$(get_session_name); then
        local label
        label=$(get_agent_label "$session_name")
        set_status "$session_name" "idle" "$label finished"
    fi
}

handle_notification() {
    local notification_type="${1:-}"
    local session_name

    if ! session_name=$(get_session_name); then
        return
    fi

    local label branch
    label=$(get_agent_label "$session_name")
    branch=$(get_branch "$session_name")

    case "$notification_type" in
        idle_prompt|permission_prompt)
            set_status "$session_name" "input" "Waiting for input"
            notify "$label needs input" "Waiting for your response" "normal" "$branch"
            ;;
        *)
            # Other notifications don't change status
            ;;
    esac
}

handle_tool_use() {
    local tool_name="${1:-}"
    local session_name

    if ! session_name=$(get_session_name); then
        return
    fi

    # When agent uses tools, it's actively working. The tool name is best-effort
    # (parsed from the hook payload); fall back to a generic message without it.
    local message="Working"
    [[ -n "$tool_name" ]] && message="Using $tool_name"
    set_status "$session_name" "working" "$message"
}

handle_error() {
    local session_name
    if session_name=$(get_session_name); then
        local label branch
        label=$(get_agent_label "$session_name")
        branch=$(get_branch "$session_name")
        set_status "$session_name" "error" "$label encountered an error"
        notify "$label error" "Something went wrong" "critical" "$branch"
    fi
}

# -----------------------------------------------------------------------------
#  Main
# -----------------------------------------------------------------------------
main() {
    local hook_type="${1:-}"
    local extra="${2:-}"

    # Agents pass event context as JSON on stdin (Claude, Gemini, opencode);
    # there is no $CLAUDE_TOOL_NAME/$TOOL_NAME env var, so the tool name must be
    # read from the payload's `tool_name` field, not a command-line argument.
    local stdin_data tool_name="$extra"
    stdin_data=$(read_stdin)
    if [[ -z "$tool_name" && -n "$stdin_data" ]] && command -v jq >/dev/null 2>&1; then
        tool_name=$(jq -r '.tool_name // empty' <<<"$stdin_data" 2>/dev/null || true)
    fi

    case "$hook_type" in
        session-start)
            handle_session_start
            ;;
        stop)
            handle_stop
            ;;
        notification)
            handle_notification "$extra"
            ;;
        pre-tool|post-tool)
            handle_tool_use "$tool_name"
            ;;
        error)
            handle_error
            ;;
        *)
            # Unknown hook type, ignore
            ;;
    esac
}

main "$@"
