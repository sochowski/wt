#!/usr/bin/env bash
# =============================================================================
#  wt staging stub agent
#  Stands in for claude/codex/gemini/opencode/pi inside the sandbox. wt drives it
#  exactly like a real agent (wt-agent-launch does `exec "$AGENT" "$@"`), but it
#  launches no real CLI — no creds, no API calls, no contact with your prod env.
#  Drops into an interactive shell so the pane stays alive and usable.
# =============================================================================
echo "┌─ wt stub agent ─────────────────────────────────────"
echo "│ invoked as : $(basename "$0")"
echo "│ cwd        : $PWD"
echo "│ args       : $*"
echo "│ session    : ${TMUX:+$(tmux display-message -p '#{session_name}' 2>/dev/null)}"
echo "│ (staging sandbox — no real agent launched)"
echo "└─────────────────────────────────────────────────────"
exec "${SHELL:-bash}" -i
